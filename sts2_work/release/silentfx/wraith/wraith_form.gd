extends Node
# SilentFX - Wraith Form, held: strips of grave gauze wait at the edges of the screen; carried out over the play
# area they whip in and wind up into the woman of the card's own picture, who snaps open and then waits, see-through,
# breathing - as she was approved in the cloud prototype (docs/ref/wraith_cut/anim/form.gd). This file is that
# prototype, driven by the mod instead of by a renderer:
#   build(dir, cache, back, front, lo, hi, org, k)   - back / front: nodes behind / in front of the characters (their
#                                                     coordinates the scene's); lo..hi: what of it is on screen;
#                                                     org, k: where her picture's corner goes, how big a pixel of it is
#   set_state(t, wake, clock, show)  - t < 0: the strips wait at the edges (wake 0..1: how far they have come out);
#                                      t >= 0: seconds since they were let in (she snaps open at SNAP, then breathes);
#                                      clock: a free-running clock; show 0..1: she and her strips (not the fog)
#   times()   - [SNAP, when she can be taken over by the playing of the card, when she is settled]
#   phase()   - [the phase her hair sways on, her breath]  (the playing of the card carries on from them)
#   set_top(top)   - (after build, optional) a node in front of everything - over the game's own interface. What of
#                    her lies where the interface is ("ui_...": the bands of the window it takes up) is drawn there,
#                    over it; in the middle of the field she stays behind the characters.
#   set_param(key, v)   - "haze", "shake", "dusk", "alpha", "arms";  "ui_top", "ui_bot", "ui_corner", "ui_left",
#                    "ui_right", "ui_soft": where the interface is, as fractions of the window;  "haze_ui": how much
#                    of the fog is drawn over the interface (0..1);  "blur": what moves is blurred a little (0 = not: so it is until the mod asks)
# Generated by docs/ref/wraith_cut/anim/mk_game_form.py - change the prototype and generate again, do not edit by hand.
var P := {"arms": 1.3, "alpha": 0.68, "shake": 0.6, "dusk": 1.0, "haze": 1.0,
	"ui_top": 0.15, "ui_bot": 0.80, "ui_corner": 0.70, "ui_left": 0.17, "ui_right": 0.80, "ui_soft": 0.03, "haze_ui": 0.45, "blur": 0.0}
