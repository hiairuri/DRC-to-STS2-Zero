func tex(nm: String) -> Texture2D:
	var key = "tex/" + nm
	if CACHE.has(key): return CACHE[key]
	var t = ImageTexture.create_from_image(Image.load_from_file(DIR + "/tex/" + nm))
	CACHE[key] = t
	return t

func shader_code(file: String, add: String = "") -> Shader:
	var key = "sh:" + file + add
	if CACHE.has(key): return CACHE[key]
	var sh = Shader.new()
	var code = FileAccess.get_file_as_string(DIR + "/" + file)
	if add != "": code = code.replace("shader_type canvas_item;", "shader_type canvas_item;\n" + add)
	sh.code = code
	CACHE[key] = sh
	return sh

func shader_mat(file: String) -> ShaderMaterial:
	var m = ShaderMaterial.new(); m.shader = shader_code(file)
	return m

func hash1(i: int) -> float:
	var x = sin(float(i) * 12.9898) * 43758.5453
	return x - floor(x)

func sm(a: float, b: float, x: float) -> float:
	return smoothstep(a, b, x)

func sprite(layer) -> Sprite2D:
	var s = Sprite2D.new(); s.texture = tex(layer["tex"]); s.centered = false
	s.position = Vector2(layer["ox"], layer["oy"])
	return s

func normal_at(p: PackedVector2Array, i: int) -> Vector2:
	var n = p.size()
	var t: Vector2
	if i == 0: t = p[1] - p[0]
	elif i == n - 1: t = p[n - 1] - p[n - 2]
	else: t = p[i + 1] - p[i - 1]
	if t.length_squared() < 1e-8: return Vector2.ZERO
	t = t.normalized()
	return Vector2(-t.y, t.x)

func tris(n: int) -> Array:
	var out := []
	for i in range(n - 1):
		out.append(PackedInt32Array([2 * i, 2 * i + 2, 2 * i + 3]))
		out.append(PackedInt32Array([2 * i, 2 * i + 3, 2 * i + 1]))
	return out

func edge_reach(from: Vector2, dir: Vector2, margin: float) -> float:
	var tx = 1e9; var ty = 1e9
	if dir.x > 1e-4: tx = (HI.x + margin - from.x) / dir.x
	elif dir.x < -1e-4: tx = (LO.x - margin - from.x) / dir.x
	if dir.y > 1e-4: ty = (HI.y + margin - from.y) / dir.y
	elif dir.y < -1e-4: ty = (LO.y - margin - from.y) / dir.y
	return min(tx, ty)

# ------------------------------------------------------------------ her hair: 25 strands, each a strip of the art

const THIN := 2                  # every THIN-th point of a strand's middle line is kept (they lie 8 pixels apart)

func make_strand(d, k: int, fam: int) -> Dictionary:
	var n0: int = d["pts"].size()
	var p := PackedVector2Array()
	var arc := PackedFloat32Array(); var left := PackedFloat32Array(); var right := PackedFloat32Array()
	for i in range(n0):
		if i % THIN != 0 and i != n0 - 1 and float(d["arc"][i]) > 8.0: continue
		p.append(Vector2(d["pts"][i][0], d["pts"][i][1]))
		arc.append(float(d["arc"][i])); left.append(float(d["left"][i])); right.append(float(d["right"][i]))
	var n: int = p.size()
	var st := {"d": d, "n": n, "fam": fam, "k": k, "rest": p, "arc": arc, "left": left, "right": right, "fan": d["kind"] == "fan"}
	var nr := PackedVector2Array()
	for i in range(n): nr.append(normal_at(p, i))
	st["nrm"] = nr
	var poly = Polygon2D.new()
	poly.texture = tex(d["tex"])
	var uv := PackedVector2Array(); uv.resize(n * 2)
	for i in range(n):
		uv[2 * i] = p[i] + nr[i] * left[i] - Vector2(d["ox"], d["oy"])
		uv[2 * i + 1] = p[i] - nr[i] * right[i] - Vector2(d["ox"], d["oy"])
	poly.uv = uv; poly.polygon = uv; poly.polygons = tris(n)
	st["poly"] = poly
	# where its root is (the first sample at or past 0 along it)
	var i0 = 0
	while i0 < n - 1 and arc[i0] < 0.0: i0 += 1
	st["i0"] = i0
	# ---- its way in: out of an edge of the screen, round her head in a closing whirl, to its root
	var root: Vector2 = p[i0]
	var rel = root - HEADC
	var r1 = max(rel.length(), 30.0)
	var phi1 = rel.angle()
	# (spread the places they wait at round all four edges)
	var phi0 = TAU * fposmod(k * 0.618034 + 0.07, 1.0)
	var delta = fposmod(phi1 - phi0, TAU) + TAU * (1.0 if hash1(k * 13 + 4) > 0.45 else 0.0)
	if delta < TAU * 0.6: delta += TAU
	var R0 = edge_reach(HEADC, Vector2.from_angle(phi0), 260.0)
	var NA := 96
	var ap := PackedVector2Array()
	for j in range(NA + 1):
		var u = float(j) / NA
		var phi = phi0 + delta * pow(u, 2.1)
		var rr = r1 + (R0 - r1) * pow(1.0 - u, 1.35)
		ap.append(HEADC + Vector2.from_angle(phi) * rr)
	ap[NA] = root
	var cum := PackedFloat32Array([0.0])
	for j in range(1, ap.size()): cum.append(cum[j - 1] + ap[j].distance_to(ap[j - 1]))
	st["ap"] = ap; st["cum"] = cum; st["LA"] = cum[cum.size() - 1]
	# they come one after another: each leaves its edge in its turn, whips in, and lays itself down
	var rank = max(ORDER.find(d["name"]), 0)
	st["land"] = 0.20 + 0.44 * float(rank) / float(ORDER.size() - 1)   # when its head reaches its root
	st["delay"] = max(0.0, st["land"] - 0.34)
	st["out"] = 0.10 + 0.04 * hash1(k * 13 + 6)                        # then it shoots out along its place
	st["poke"] = 420.0 + 330.0 * hash1(k * 13 + 7)
	st["w1"] = 2.5 + 2.0 * hash1(k * 13 + 8); st["ph"] = TAU * hash1(k * 13 + 9)
	return st

func track(st: Dictionary, s: float) -> Vector2:
	# s: 0 at its root, negative back along its way in, positive out along its place
	if s >= 0.0:
		var arc: PackedFloat32Array = st["arc"]
		var rest: PackedVector2Array = st["rest"]
		var n: int = st["n"]
		if s >= arc[n - 1]:
			var t: Vector2 = (rest[n - 1] - rest[n - 2]).normalized()
			return rest[n - 1] + t * (s - arc[n - 1])
		var lo: int = st["i0"]
		var hi: int = n - 1
		while hi - lo > 1:
			var mid: int = (lo + hi) >> 1
			if arc[mid] <= s: lo = mid
			else: hi = mid
		var seg: float = arc[hi] - arc[lo]
		return rest[lo].lerp(rest[hi], 0.0 if seg < 1e-5 else (s - arc[lo]) / seg)
	var ap: PackedVector2Array = st["ap"]
	var cum: PackedFloat32Array = st["cum"]
	var x: float = float(st["LA"]) + s
	if x <= 0.0:
		var t0: Vector2 = (ap[0] - ap[1]).normalized()
		return ap[0] + t0 * (-x)
	var lo2: int = 0
	var hi2: int = cum.size() - 1
	while hi2 - lo2 > 1:
		var m2: int = (lo2 + hi2) >> 1
		if cum[m2] <= x: lo2 = m2
		else: hi2 = m2
	var sg: float = cum[hi2] - cum[lo2]
	return ap[lo2].lerp(ap[hi2], 0.0 if sg < 1e-5 else (x - cum[lo2]) / sg)

func breath_at(ph: float) -> float:
	var t = fposmod(ph / TAU, 1.0)
	if t < 0.42:
		var a = t / 0.42
		return a * a * (3.0 - 2.0 * a)
	var b = (t - 0.42) / 0.58
	return pow(0.5 + 0.5 * cos(PI * min(b * 1.12, 1.0)), 1.3)

func rise_at(ph: float) -> float:
	return 2.0 * breath_at(ph - 0.30) - 1.0

func breathe(p: Vector2) -> Vector2:
	var dx: float = p.x - CHEST.x
	var dy: float = p.y - CHEST.y
	var k: float = SWELL * breath * exp(-(dx * dx) / 28900.0 - (dy * dy) / 40000.0)
	return Vector2(p.x + dx * k, p.y + dy * k - LIFT * breath * smoothstep(CHEST.y + 90.0, CHEST.y - 130.0, p.y))

func idle_points(st: Dictionary, ph: float, amt: float) -> PackedVector2Array:
	# where every point of a strand is as she waits: it sways along itself, goes with her breath, and trails a
	# little behind her rise and fall
	var n: int = st["n"]
	var rest: PackedVector2Array = st["rest"]
	var nrm: PackedVector2Array = st["nrm"]
	var arc: PackedFloat32Array = st["arc"]
	var f: int = st["fam"]
	var fan: bool = st["fan"]
	var a: float = 20.0 if fan else 15.0
	var k1: float = 2.2 if fan else 1.5
	var k2: float = 4.6 if fan else 3.3
	var ph1: float = TAU * hash1(f * 7 + 1) * (1.0 if fan else 0.35) + (0.0 if fan else 0.6)
	var ph2: float = TAU * hash1(f * 7 + 2)
	var out := PackedVector2Array(); out.resize(n)
	for i in range(n):
		var u: float = max(arc[i], 0.0) / 600.0
		var uc: float = min(u, 1.7)
		var amp: float = a * pow(uc, 1.5) * amt
		var w: float = sin(ph - k1 * u + ph1) + 0.45 * sin(2.0 * ph - k2 * u + ph2)
		var q: Vector2 = breathe(rest[i] + nrm[i] * (amp * w))
		var kk: float = pow(uc, 1.3) * amt
		var lag: float = -(rise_at(ph - 0.5 * u + 0.05) - rise_at(ph - 0.5 * u - 0.05)) / 0.10
		var outw: float = 1.0 if q.x > CHEST.x else -1.0
		out[i] = q + Vector2(outw * 5.0 * kk * lag, -8.0 * kk * lag)
	return out

func pose_strand(st: Dictionary, t: float, ph: float, idle: float) -> void:
	var n: int = st["n"]
	var arc: PackedFloat32Array = st["arc"]
	var last: float = arc[n - 1]
	var poly: Polygon2D = st["poly"]
	var land: float = st["land"]
	var delay: float = st["delay"]
	var sph: float = st["ph"]
	var la: float = st["LA"]
	var head: float            # where its head is along its track
	var stretch: float = 1.0
	var settled: float = 0.0
	var moving: bool = t < land
	if t < delay:
		# waiting at the edge of the screen: its head pokes in, feels about, darts
		var probe: float = 0.72 + 0.20 * sin(CL * float(st["w1"]) * 1.7 + sph) + 0.34 * pow(max(0.0, sin(CL * 2.3 + sph * 3.0)), 6.0)
		head = -la + (260.0 + float(st["poke"])) * probe * WAKE - 260.0
	elif t < land:
		var x: float = (t - delay) / (land - delay)
		var e: float = pow(x, 2.6)                            # it gathers speed all the way in: a whip
		head = lerp(-la + float(st["poke"]) * 0.9, 0.0, e)
		stretch = 1.0 + 1.5 * pow(sin(PI * min(x * 1.08, 1.0)), 1.2)
	else:
		var y: float = clamp((t - land) / float(st["out"]), 0.0, 1.0)
		head = last * (1.0 - pow(1.0 - y, 2.2))               # out of her head along its own place, and stops dead
		stretch = 1.0 + 0.5 * (1.0 - y)
		settled = smoothstep(0.75, 1.0, y)
	var tau: float = t - (land + float(st["out"]))
	var pts := PackedVector2Array(); pts.resize(n)
	if settled < 1.0:
		for i in range(n):
			pts[i] = track(st, head - (last - arc[i]) * stretch)
		if moving:
			# on its way it writhes
			var was: PackedVector2Array = pts.duplicate()
			var wt: float = CL if t < delay else t
			for i in range(n):
				var f: float = float(i) / (n - 1)
				pts[i] = was[i] + normal_at(was, i) * (16.0 * (0.3 + 0.7 * f) * sin(wt * 15.0 - f * 7.0 + sph))
	if settled > 0.0:
		var g: PackedVector2Array = idle_points(st, ph, idle)
		var ts: float = t - SNAP
		var lash: bool = tau > 0.0 and tau < 1.5
		var taut: float = 26.0 * smoothstep(SNAP - 0.11, SNAP, t) if ts < 0.0 else 0.0
		var snap: bool = ts >= 0.0 and ts < 2.4
		if lash or snap or taut > 0.0:
			var nrm: PackedVector2Array = st["nrm"]
			var e1: float = 34.0 * exp(-tau / 0.09) if lash else 0.0
			var e2: float = 30.0 * exp(-tau / 0.16) if lash else 0.0
			var e3: float = 120.0 * exp(-ts / 0.14) if snap else 0.0
			var e4: float = 62.0 * exp(-ts / 0.26) if snap else 0.0
			for i in range(n):
				var u: float = min(max(arc[i], 0.0) / 600.0, 1.6)
				var gi: Vector2 = g[i]
				var away: Vector2 = gi - HEADC
				var dirv: Vector2 = away.normalized() if away.length_squared() > 1.0 else Vector2.UP
				if lash:
					# it has shot a little past where it belongs: it lashes once and lies still
					gi += dirv * (e1 * u) + nrm[i] * (e2 * sin(tau * 24.0 - 4.0 * max(arc[i], 0.0) / 600.0 + sph) * pow(u, 1.2))
				if ts < 0.0:
					gi -= dirv * (taut * u)                                     # drawn taut...
				elif snap:
					# ...and let go: all of her hair is thrown out from her head, lashes, and comes to rest
					gi += dirv * (e3 * u) + nrm[i] * (e4 * sin(ts * 21.0 - 4.0 * max(arc[i], 0.0) / 600.0 + sph) * pow(u, 1.2))
				g[i] = gi
		if settled >= 1.0: pts = g
		else:
			for i in range(n): pts[i] = pts[i].lerp(g[i], settled)
	var left: PackedFloat32Array = st["left"]
	var right: PackedFloat32Array = st["right"]
	var v := PackedVector2Array(); v.resize(n * 2)
	var fat: float = 1.35 if moving else 1.0
	for i in range(n):
		var tn: Vector2
		if i == 0: tn = pts[1] - pts[0]
		elif i == n - 1: tn = pts[n - 1] - pts[n - 2]
		else: tn = pts[i + 1] - pts[i - 1]
		var nr := Vector2.ZERO
		if tn.length_squared() >= 1e-8:
			tn = tn.normalized()
			nr = Vector2(-tn.y, tn.x)
		v[2 * i] = pts[i] + nr * (left[i] * fat)
		v[2 * i + 1] = pts[i] - nr * (right[i] * fat)
	poly.polygon = v

# ------------------------------------------------------------------ loose gauze: the turns that wind her body, the shreds thrown off

func make_ribbon(n: int, seed: int) -> Dictionary:
	var rb := {"n": n}
	var m = ShaderMaterial.new(); m.shader = strip_shader
	var polys := []
	for layer in range(2):
		var poly = Polygon2D.new(); poly.texture = white; poly.material = m
		var uv := PackedVector2Array(); uv.resize(n * 2)
		for i in range(n):
			uv[2 * i] = Vector2(float(i) / (n - 1), 0.0); uv[2 * i + 1] = Vector2(float(i) / (n - 1), 1.0)
		poly.uv = uv; poly.polygon = uv; poly.polygons = tris(n)
		polys.append(poly)
	rb["polys"] = polys
	rb["tintc"] = 0.3 + 0.7 * hash1(seed * 3 + 1)
	return rb

func set_ribbon(rb, pts: PackedVector2Array, widths: PackedFloat32Array, front: PackedFloat32Array, alpha: float):
	var n = rb["n"]
	var v := PackedVector2Array(); v.resize(n * 2)
	var cf := PackedColorArray(); cf.resize(n * 2)
	var cb := PackedColorArray(); cb.resize(n * 2)
	for i in range(n):
		var nr = normal_at(pts, i)
		v[2 * i] = pts[i] + nr * widths[i]; v[2 * i + 1] = pts[i] - nr * widths[i]
		var f = front[i]
		cf[2 * i] = Color(rb["tintc"], 1, 1, alpha * f); cf[2 * i + 1] = cf[2 * i]
		cb[2 * i] = Color(rb["tintc"], 1, 1, alpha * (1.0 - f) * 0.75); cb[2 * i + 1] = cb[2 * i]
	rb["polys"][0].polygon = v; rb["polys"][0].vertex_colors = cb
	rb["polys"][1].polygon = v; rb["polys"][1].vertex_colors = cf
	rb["polys"][0].visible = alpha > 0.004; rb["polys"][1].visible = alpha > 0.004

func make_wrap(j: int, count: int) -> Dictionary:
	var w = make_ribbon(30, j + 100)
	w["y"] = lerp(575.0, 905.0, (float(j) + 0.5) / count)
	w["dir"] = -1.0 if j % 2 == 0 else 1.0               # it comes down from above, or up from below
	w["th0"] = TAU * hash1(j * 17 + 1)
	w["turns"] = 2.1 + 0.9 * hash1(j * 17 + 2)
	w["delay"] = 0.02 + 0.10 * hash1(j * 17 + 3)
	w["wide"] = 17.0 + 9.0 * hash1(j * 17 + 4)
	w["span"] = 2.3 + 1.0 * hash1(j * 17 + 5)
	w["spin"] = 1.0 if j % 3 != 0 else -1.0
	return w

func pose_wrap(w, t: float):
	var n = w["n"]
	var x = clamp((t - w["delay"]) / (0.40 - w["delay"]), 0.0, 1.0)
	var e = pow(x, 1.9)
	var alpha = sm(w["delay"], w["delay"] + 0.06, t) * (1.0 - sm(0.40, 0.62, t))
	if alpha <= 0.004:
		w["polys"][0].visible = false; w["polys"][1].visible = false
		return
	var far = pow(1.0 - e, 2.3)
	var waiting = 1.0 - sm(0.0, 0.12, t - w["delay"])
	var th_h = w["th0"] + w["spin"] * TAU * w["turns"] * e + 0.25 * sin(t * 2.1 + w["th0"]) * waiting
	var torso = 128.0 + 26.0 * sm(700.0, 590.0, w["y"])          # she is wider at the shoulders
	var pts := PackedVector2Array(); pts.resize(n)
	var widths := PackedFloat32Array(); widths.resize(n)
	var front := PackedFloat32Array(); front.resize(n)
	for i in range(n):
		var f = float(i) / (n - 1)                                 # 0 at its tail, 1 at its head
		var dl = (1.0 - f) * w["span"]
		var th = th_h - w["spin"] * dl
		var R = torso + 3400.0 * far + dl * 330.0 * (1.0 - e)
		var yc = w["y"] + w["dir"] * (780.0 * pow(1.0 - e, 1.6)) - w["dir"] * dl * 20.0 * e
		pts[i] = Vector2(CHEST.x + R * cos(th), yc + R * 0.24 * sin(th) + 9.0 * sin(t * 13.0 + f * 6.0 + w["th0"]) * (1.0 - e))
		widths[i] = w["wide"] * (0.35 + 0.65 * sin(PI * clamp(f * 1.05, 0.0, 1.0))) * (1.0 + 0.8 * (1.0 - e))
		front[i] = sm(-0.18, 0.18, sin(th))
	set_ribbon(w, pts, widths, front, alpha)

func make_armwrap(j: int) -> Dictionary:
	var w = make_ribbon(26, j + 500)
	w["right"] = j % 2 == 1
	w["th0"] = TAU * hash1(j * 23 + 1)
	w["delay"] = 0.30 + 0.035 * float(j / 2)
	w["wide"] = 13.0 + 6.0 * hash1(j * 23 + 2)
	return w

func pose_armwrap(w, t: float):
	# from her shoulder the winding runs on down her arm, round and round, to her fist
	var n = w["n"]
	var sh = SH_R if w["right"] else SH_L
	var fist = FIST_R if w["right"] else FIST_L
	var axis = fist - sh
	var perp = Vector2(-axis.y, axis.x).normalized()
	var x = clamp((t - w["delay"]) / 0.24, 0.0, 1.0)
	var alpha = sm(0.0, 0.04, t - w["delay"]) * (1.0 - sm(w["delay"] + 0.22, w["delay"] + 0.40, t))
	if alpha <= 0.004:
		w["polys"][0].visible = false; w["polys"][1].visible = false
		return
	var head = lerp(-0.25, 1.22, x)
	var pts := PackedVector2Array(); pts.resize(n)
	var widths := PackedFloat32Array(); widths.resize(n)
	var front := PackedFloat32Array(); front.resize(n)
	for i in range(n):
		var f = float(i) / (n - 1)
		var s = head - (1.0 - f) * 0.62
		var th = w["th0"] + s * 15.0
		var R = 40.0 + 55.0 * (1.0 - x) + 16.0 * sin(s * 3.0)
		pts[i] = sh + axis * s + perp * (R * cos(th)) + axis.normalized() * (R * 0.25 * sin(th))
		widths[i] = w["wide"] * (0.35 + 0.65 * sin(PI * clamp(f * 1.05, 0.0, 1.0)))
		front[i] = sm(-0.18, 0.18, sin(th))
	set_ribbon(w, pts, widths, front, alpha)

func make_shred(j: int, count: int) -> Dictionary:
	var s = make_ribbon(22, j + 300)
	s["ang"] = TAU * (float(j) + 0.5 * hash1(j * 5 + 1)) / count
	s["delay"] = 0.03 * hash1(j * 5 + 2)
	s["len"] = 620.0 + 520.0 * hash1(j * 5 + 3)
	s["wide"] = 18.0 + 14.0 * hash1(j * 5 + 4)
	s["curl"] = (hash1(j * 5 + 5) - 0.5) * 2.4
	s["ph"] = TAU * hash1(j * 5 + 6)
	return s

func pose_shred(s, t: float):
	var n = s["n"]
	var tau = t - SNAP - s["delay"]
	if tau < 0.0 or tau > 0.42:
		s["polys"][0].visible = false; s["polys"][1].visible = false
		return
	var y = tau / 0.42
	var headr = 60.0 + 3300.0 * (1.0 - pow(1.0 - y, 2.0))
	var alpha = (1.0 - y * y) * min(1.0, tau / 0.02)
	var pts := PackedVector2Array(); pts.resize(n)
	var widths := PackedFloat32Array(); widths.resize(n)
	var front := PackedFloat32Array(); front.resize(n)
	for i in range(n):
		var f = float(i) / (n - 1)
		var r = max(40.0, headr - (1.0 - f) * s["len"] * (0.5 + 1.2 * y))
		var a = s["ang"] + s["curl"] * (r / 1800.0)
		var flut = 34.0 * sin(f * 8.0 - tau * 46.0 + s["ph"]) * (0.3 + 0.7 * y)
		pts[i] = CHEST + Vector2(0, -120) + Vector2(cos(a), sin(a) * 0.85) * r + Vector2(-sin(a), cos(a)) * flut
		widths[i] = s["wide"] * (0.25 + 0.75 * sin(PI * f)) * (1.0 + 0.6 * y)
		front[i] = 1.0
	set_ribbon(s, pts, widths, front, alpha)

# ------------------------------------------------------------------ the whole of her at time t

func fist_at(sh: Vector2, fist: Vector2, ang: Vector2) -> Vector2:
	var elbow = sh.lerp(fist, 0.5)
	var f = elbow + (fist - elbow).rotated(ang.y)
	return sh + (f - sh).rotated(ang.x)

func pose(t: float):
	var since = t - SNAP
	var idle = sm(0.15, 1.1, since)                      # the breath that carries her takes over
	var ph = TAU * max(0.0, since - 0.05) / 4.0
	PH = ph
	breath = breath_at(ph) * idle
	for st in strands: pose_strand(st, t, ph, idle)
	for w in wraps: pose_wrap(w, t)
	for w in armwraps: pose_armwrap(w, t)
	for s in shreds: pose_shred(s, t)
	# ---- she is WOUND, piece by piece, out of the gauze; nothing hides it
	var torso = sm(0.20, 0.58, t)                        # her body: turn by turn, under the turns of gauze that close on it
	var arms = clamp((t - 0.33) / 0.25, 0.0, 1.0)        # her arms: from her shoulders down to her fists, after the winding
	var horn = clamp((since + 0.015) / 0.085, 0.0, 1.0)  # her horns: thrust out of her head as she snaps open
	dress_mat.set_shader_parameter("grow", sm(0.40, 0.98, t))
	# drawn taut, then let go: she is thrown up a little and swells with it, then settles
	var taut = sm(SNAP - 0.11, SNAP, t) * (1.0 if since < 0.0 else 0.0)
	var pop = exp(-max(since, 0.0) / 0.11) * (1.0 if since >= 0.0 else 0.0)
	var bob = rise_at(ph) * idle
	figure.scale = Vector2(1.0 - 0.065 * taut + 0.14 * pop * cos(since * 24.0), 1.0 + 0.03 * taut + 0.14 * pop * cos(since * 24.0))
	figure.position = CHEST - CHEST * figure.scale + Vector2(0, -11.0 * bob - 28.0 * pop + 8.0 * taut)
	var r = deg_to_rad(1.0) * P["arms"] * idle
	var upper = 3.3 * (2.0 * breath_at(ph - 0.15) - 1.0)
	var fore = 3.0 * (2.0 * breath_at(ph - 0.55) - 1.0)
	var al = Vector2(r * upper, r * fore); var ar = Vector2(-r * upper, -r * fore)
	for m in body_mats:
		m.set_shader_parameter("breath", breath)
		m.set_shader_parameter("arm_l", al); m.set_shader_parameter("arm_r", ar)
		m.set_shader_parameter("hands", arms)
		m.set_shader_parameter("torso", torso)
		m.set_shader_parameter("horn", horn)
		m.set_shader_parameter("head", sm(0.58, 0.72, t))
	for f in fires: f.visible = false                    # (no fire on her fists yet: it catches when the card is played)
	var vel = -(rise_at(ph + 0.05) - rise_at(ph - 0.05)) / 0.10
	dress_mat.set_shader_parameter("phase", ph)
	dress_mat.set_shader_parameter("hang", -vel * idle)
	dress_mat.set_shader_parameter("breath", breath)
	var lit = exp(-max(since, 0.0) / 0.22) if since >= 0.0 else 0.0
	glow.modulate = Color(1, 1, 1, 0.38 + 0.20 * breath + 1.6 * lit)
	# opaque while she is wound; at the snap she is a black shape against the light for an instant; then a ghost of gauze
	var dark = lerp(0.16, 1.0, sm(0.0, 0.17, since)) if since >= 0.0 else 1.0
	figure.self_modulate = Color(dark, dark, dark, lerp(1.0, P["alpha"], sm(0.25, 0.95, since)))
	# ---- the stage
	var wake = WAKE
	for hm in haze_mats:
		hm.set_shader_parameter("clock", CL + 10.0)
		hm.set_shader_parameter("intensity", P["haze"] * wake * (0.70 + 0.20 * sm(0.0, SNAP, t)) * (1.0 - 0.25 * sm(0.0, 0.8, since)))
		hm.set_shader_parameter("reach", 0.18 + 0.10 * sm(0.0, SNAP, t) + 0.10 * lit)
	# the light of the snap is BEHIND her
	flash.visible = since >= 0.0 and since < 0.42
	if flash.visible:
		var gq = since / 0.42
		flash.scale = Vector2.ONE * ((7.0 + 9.0 * (1.0 - pow(1.0 - gq, 2.0))) * KK)
		flash.modulate = Color(0.78, 1.0, 0.80, SHOW * pow(1.0 - gq, 1.6))
	ring.visible = since >= 0.0 and since < 0.55
	if ring.visible:
		var g2 = since / 0.55
		ring_mat.set_shader_parameter("radius", 0.02 + 0.98 * (1.0 - pow(1.0 - g2, 2.4)))
		ring_mat.set_shader_parameter("width", 0.012 + 0.03 * g2)
		ring_mat.set_shader_parameter("alpha", 0.9 * (1.0 - g2))
	ring2.visible = since >= 0.07 and since < 0.75
	if ring2.visible:
		var g3 = (since - 0.07) / 0.68
		ring2_mat.set_shader_parameter("radius", 0.02 + 0.98 * (1.0 - pow(1.0 - g3, 2.0)))
		ring2_mat.set_shader_parameter("width", 0.03 + 0.07 * g3)
		ring2_mat.set_shader_parameter("alpha", 0.45 * (1.0 - g3))
	tint.color = Color(0.45, 1.0, 0.55, 0.22 * lit * lit)
	# the field darkens as she is wound, so that the snap has something to light; held, a little dusk stays
	var dusk = 0.55 * sm(0.0, SNAP, t) * (1.0 - sm(0.0, 0.30, since)) + 0.16 * sm(0.0, 0.5, since)
	veil.color = Color(0.012, 0.050, 0.032, dusk * SHOW * P["dusk"])
	var shk = 16.0 * exp(-max(since, 0.0) / 0.10) if since >= 0.0 else 0.0
	world.position = ORG + Vector2(shk * sin(since * 93.0), shk * cos(since * 71.0)) * (P["shake"] * KK)
	world.modulate = Color(1, 1, 1, SHOW)
	root_f.modulate = Color(1, 1, 1, SHOW)
	pose_veil(t)
	if root_t != null: sync_top()

func build(p_dir: String, p_cache: Dictionary, p_back: Node, p_front: Node, p_lo: Vector2, p_hi: Vector2, p_org: Vector2, p_k: float) -> bool:
	DIR = p_dir; CACHE = p_cache
	if CACHE.has("rig"): rig = CACHE["rig"]
	else:
		rig = JSON.parse_string(FileAccess.get_file_as_string(DIR + "/rig.json"))
		CACHE["rig"] = rig
	if rig == null: return false
	ORG = p_org; K = p_k; KK = p_k / 0.62
	var span = p_hi - p_lo
	LO = (p_lo - ORG) / K; HI = (p_hi - ORG) / K
	if CACHE.has("white"): white = CACHE["white"]
	else:
		var img = Image.create(1, 1, false, Image.FORMAT_RGBA8); img.fill(Color.WHITE)
		white = ImageTexture.create_from_image(img)
		CACHE["white"] = white
	strip_shader = shader_code("strip.gdshader")
	root_b = Node2D.new(); p_back.add_child(root_b)
	root_f = Node2D.new(); p_front.add_child(root_f)
	# ---- the fog of the standby, the dusk, the light behind her
	haze = ColorRect.new(); haze.mouse_filter = Control.MOUSE_FILTER_IGNORE; haze.position = p_lo; haze.size = span; haze.mouse_filter = Control.MOUSE_FILTER_IGNORE
	haze_mat = shader_mat("wraith_haze.gdshader"); haze.material = haze_mat
	haze_mat.set_shader_parameter("aspect", span.x / max(span.y, 1.0))
	root_b.add_child(haze)
	haze_mats = [haze_mat]
	VLO = p_lo; VHI = p_hi
	veil = ColorRect.new(); veil.mouse_filter = Control.MOUSE_FILTER_IGNORE; veil.position = p_lo - Vector2(600, 600); veil.size = span + Vector2(1200, 1200); veil.color = Color(0, 0, 0, 0)
	veil.mouse_filter = Control.MOUSE_FILTER_IGNORE; root_b.add_child(veil)
	backlight = Node2D.new(); root_b.add_child(backlight)
	world = Node2D.new(); world.position = ORG; world.scale = Vector2(K, K); root_b.add_child(world)
	shredn = Node2D.new(); world.add_child(shredn)
	figure = CanvasGroup.new(); figure.fit_margin = 40.0; figure.clear_margin = 40.0; world.add_child(figure)
	back = Node2D.new(); figure.add_child(back)
	wraps_back = Node2D.new(); figure.add_child(wraps_back)
	var L = rig["layers"]
	dress = sprite(L["dress"]); dress_mat = shader_mat("dress.gdshader"); dress.material = dress_mat; figure.add_child(dress)
	dress_mat.set_shader_parameter("origin", Vector2(L["dress"]["ox"], L["dress"]["oy"])); dress_mat.set_shader_parameter("extent", Vector2(L["dress"]["w"], L["dress"]["h"]))
	bodys = sprite(L["body"]); var bm = shader_mat("body.gdshader"); bodys.material = bm; body_mats.append(bm)
	bm.set_shader_parameter("origin", Vector2(L["body"]["ox"], L["body"]["oy"])); bm.set_shader_parameter("extent", Vector2(L["body"]["w"], L["body"]["h"]))
	figure.add_child(bodys)
	for key in ["fireL", "fireR"]:
		var f = sprite(L[key]); figure.add_child(f); fires.append(f)
	wraps_front = Node2D.new(); figure.add_child(wraps_front)
	frontn = Node2D.new(); figure.add_child(frontn)
	var fams := {}
	var k := 0
	for d in rig["strands"]:
		if not fams.has(d["family"]): fams[d["family"]] = fams.size()
		var st = make_strand(d, k, fams[d["family"]]); k += 1
		strands.append(st)
		(back if st["fan"] else frontn).add_child(st["poly"])
	for j in range(16):
		var w = make_wrap(j, 16); wraps.append(w)
		wraps_back.add_child(w["polys"][0]); wraps_front.add_child(w["polys"][1])
	for j in range(6):
		var aw = make_armwrap(j); armwraps.append(aw)
		wraps_back.add_child(aw["polys"][0]); wraps_front.add_child(aw["polys"][1])
	for j in range(26):
		var s = make_shred(j, 26); shreds.append(s)
		shredn.add_child(s["polys"][0]); shredn.add_child(s["polys"][1])
	glow = sprite(L["glow"])
	var gm = ShaderMaterial.new(); gm.shader = shader_code("body.gdshader", "render_mode blend_add;"); glow.material = gm; body_mats.append(gm)
	gm.set_shader_parameter("origin", Vector2(L["glow"]["ox"], L["glow"]["oy"])); gm.set_shader_parameter("extent", Vector2(L["glow"]["w"], L["glow"]["h"]))
	figure.add_child(glow)
	# ---- the light of the burst
	var grad = Gradient.new(); grad.offsets = PackedFloat32Array([0, 0.35, 1]); grad.colors = PackedColorArray([Color(1, 1, 1, 1), Color(1, 1, 1, 0.5), Color(1, 1, 1, 0)])
	var gt = GradientTexture2D.new(); gt.gradient = grad; gt.width = 128; gt.height = 128; gt.fill = GradientTexture2D.FILL_RADIAL; gt.fill_from = Vector2(0.5, 0.5); gt.fill_to = Vector2(1.0, 0.5)
	var addm = CanvasItemMaterial.new(); addm.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	flash = Sprite2D.new(); flash.texture = gt; flash.material = addm; flash.position = ORG + (CHEST + Vector2(0, -150)) * K; backlight.add_child(flash)
	ring = ColorRect.new(); ring.mouse_filter = Control.MOUSE_FILTER_IGNORE; ring.size = Vector2(2600, 2600) * KK; ring.position = ORG + HEADC * K - Vector2(1300, 1300) * KK; ring.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ring_mat = shader_mat("ring.gdshader"); ring.material = ring_mat; root_f.add_child(ring)
	ring2 = ColorRect.new(); ring2.mouse_filter = Control.MOUSE_FILTER_IGNORE; ring2.size = Vector2(2600, 2600) * KK; ring2.position = ring.position; ring2.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ring2_mat = shader_mat("ring.gdshader"); ring2.material = ring2_mat; ring2_mat.set_shader_parameter("colour", Color(0.25, 0.85, 0.40)); root_f.add_child(ring2)
	tint = ColorRect.new(); tint.mouse_filter = Control.MOUSE_FILTER_IGNORE; tint.position = p_lo; tint.size = span; tint.material = addm; tint.color = Color(0, 0, 0, 0); tint.mouse_filter = Control.MOUSE_FILTER_IGNORE; root_f.add_child(tint)
	built = true
	set_state(-1.0, 0.0, 0.0, 1.0)
	return true

func set_state(t: float, wake: float, clock: float, show: float) -> void:
	if not built: return
	WAKE = clamp(wake, 0.0, 1.0); CL = clock; SHOW = clamp(show, 0.0, 1.0)
	if topped and not is_instance_valid(root_t):
		# (the layer in front of everything has been taken away under her: what was on it is gone, and she stops)
		built = false
		return
	if zdirty: zone_numbers()
	pose(t if t >= 0.0 else -1.0)

func set_param(key: String, value: float) -> void:
	P[key] = value
	if key.begins_with("ui_") or key == "haze_ui": zdirty = true

# ---- B. what of her lies where the game's own interface is, is drawn over the interface (v0.47)
# The interface takes up bands of the window: one along the top (the bar, the relics under it), one along the bottom
# (the hand), and the two bottom corners up to a little higher (energy and the piles; the end of the turn). No
# character stands there. Every strip of hers that can come to lie in them is drawn twice - where it always was,
# behind the characters; and again on a stage in front of everything - and each of the two shows of every point
# only its share, by where that point is on the screen: in the middle of the field all of it is the first one's,
# in the bands all of it the second's, across a soft edge between them a share each - shares that together are the
# strip drawn once, exactly (wz_a below; wz_outer: how see-through the group is that both are drawn through;
# wz_veil: a colour that lies over the first one where it is, and so is laid over the second one too).
const WZ_HEAD := """uniform vec4 wz_y = vec4(-2.0e9, -1.0e9, 1.0e9, 2.0e9);
uniform vec4 wz_c = vec4(-2.0e9, 2.0e9, 2.0e9, 1.0);
uniform float wz_side = 0.0;
uniform float wz_outer = 1.0;
uniform float wz_gain = 1.0;
uniform vec4 wz_veil = vec4(0.0);
varying vec2 wz_p;
float wz_a(float a) {
	float w = max(1.0 - smoothstep(wz_y.x, wz_y.y, wz_p.y), smoothstep(wz_y.z, wz_y.w, wz_p.y));
	float cx = max(1.0 - smoothstep(wz_c.x - wz_c.w, wz_c.x + wz_c.w, wz_p.x), smoothstep(wz_c.y - wz_c.w, wz_c.y + wz_c.w, wz_p.x));
	w = max(w, cx * smoothstep(wz_c.z - wz_c.w, wz_c.z + wz_c.w, wz_p.y)) * wz_gain;
	if (wz_side > 0.5) return a * w;
#ifdef WZ_ADD
	return a * (1.0 - w);
#else
	return a * (1.0 - w) / max(1.0 - wz_outer * a * w, 0.0001);
#endif
}
"""

func zoned(code: String, add: bool) -> Shader:
	# a shader of hers, made to draw only its share of every point (see above). The share is the last thing its
	# fragment() works out; where the point is on the screen, the first thing its vertex() does.
	var key = "shz:" + str(code.hash()) + ("+" if add else "")
	if CACHE.has(key): return CACHE[key]
	var c := code
	var f: int = c.find("void fragment()")
	var e := -1
	if f >= 0:
		var depth := 0
		var j: int = c.find("{", f)
		while j >= 0 and j < c.length():
			var ch: String = c[j]
			if ch == "{": depth += 1
			elif ch == "}":
				depth -= 1
				if depth == 0:
					e = j
					break
			j += 1
	if e >= 0:
		c = c.substr(0, e) + "\tCOLOR.rgb = mix(COLOR.rgb, wz_veil.rgb, wz_veil.a);\n\tCOLOR.a = wz_a(COLOR.a);\n" + c.substr(e)
		if c.find("void vertex() {") >= 0: c = c.replace("void vertex() {", "void vertex() {\n\twz_p = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;")
		else: c += "\nvoid vertex() {\n\twz_p = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;\n}\n"
		c = c.replace("shader_type canvas_item;", "shader_type canvas_item;\n" + ("render_mode blend_add;\n#define WZ_ADD\n" if add else "") + WZ_HEAD)
	if e < 0 or c.find("wz_a(COLOR.a)") < 0 or c.find("uniform vec4 wz_y") < 0: push_error("Wraith Form: a shader of hers could not be made to share itself with the layer in front - it will be drawn twice")
	var sh := Shader.new(); sh.code = c
	CACHE[key] = sh
	return sh

func zone_mat(kind: String, side: int) -> ShaderMaterial:
	# kind: "mix" a plain picture, "strip" a loose strip of gauze (strip.gdshader); with "+g": drawn through her
	# group. side: its share behind the interface (0), or over it (1)
	var key = kind + str(side)
	if ZM.has(key): return ZM[key]
	var m := ShaderMaterial.new()
	m.shader = zoned(strip_shader.code if kind.begins_with("strip") else "shader_type canvas_item;\nvoid fragment() {\n}\n", false)
	m.set_shader_parameter("wz_side", float(side))
	ZM[key] = m; zmats.append(m)
	if kind.ends_with("+g"): gmats.append(m)
	return m

func zone_numbers() -> void:
	# where the bands of the interface are, in the scene's own coordinates (the mod says what part of the window
	# they take up: "ui_top" - the top band down to there; "ui_bot" - the bottom band from there; "ui_left",
	# "ui_right", "ui_corner" - the bottom corners: left of / right of / below; "ui_soft" - how wide the edge is)
	zdirty = false
	var high: float = VHI.y - VLO.y
	var wide: float = VHI.x - VLO.x
	var s: float = max(float(P["ui_soft"]), 0.002) * high * 0.5
	var zy := Vector4(-2.0e9, -1.0e9, 1.0e9, 2.0e9)
	if P["ui_top"] > 0.0:
		zy.x = VLO.y + P["ui_top"] * high - s; zy.y = zy.x + 2.0 * s
	if P["ui_bot"] < 1.0:
		zy.z = VLO.y + P["ui_bot"] * high - s; zy.w = zy.z + 2.0 * s
	var zc := Vector4(-2.0e9, 2.0e9, 2.0e9, s)
	if P["ui_corner"] < P["ui_bot"]:
		zc.z = VLO.y + P["ui_corner"] * high
		if P["ui_left"] > 0.0: zc.x = VLO.x + P["ui_left"] * wide
		if P["ui_right"] < 1.0: zc.y = VLO.x + P["ui_right"] * wide
	for m in zmats:
		m.set_shader_parameter("wz_y", zy); m.set_shader_parameter("wz_c", zc)
	# (the fog: only this much of it goes over the interface - what is written there has to be read)
	if haze_mats.size() > 1:
		for hm in haze_mats: hm.set_shader_parameter("wz_gain", clamp(float(P["haze_ui"]), 0.0, 1.0))

func twin_poly(src: Polygon2D, par_t: Node, kind: String, own_colours: bool) -> void:
	var tp := Polygon2D.new(); tp.texture = src.texture; tp.polygon = src.polygon; tp.uv = src.uv; tp.polygons = src.polygons
	tp.visible = false; par_t.add_child(tp)
	src.material = zone_mat(kind, 0); tp.material = zone_mat(kind, 1)
	ptwins.append([src, tp, own_colours])

func set_top(p_top: Node) -> bool:
	# A stage in front of everything (the mod puts it over the game's own interface).
	if not built or p_top == null or root_t != null: return false
	root_t = Node2D.new(); p_top.add_child(root_t)
	topped = true
	# the fog comes in over the interface too
	var zh: Shader = zoned(shader_code("wraith_haze.gdshader").code, false)
	var hlo := ShaderMaterial.new(); hlo.shader = zh
	var hhi := ShaderMaterial.new(); hhi.shader = zh
	hhi.set_shader_parameter("wz_side", 1.0)
	for hm in [hlo, hhi]:
		hm.set_shader_parameter("aspect", haze_mat.get_shader_parameter("aspect"))
		hm.set_shader_parameter("intensity", 0.0)
		zmats.append(hm)
	haze_mats = [hlo, hhi]
	haze.material = hlo
	haze_t = ColorRect.new(); haze_t.mouse_filter = Control.MOUSE_FILTER_IGNORE; haze_t.position = haze.position; haze_t.size = haze.size; haze_t.material = hhi
	root_t.add_child(haze_t)
	# her strips again, in the order they are drawn in: the shreds; then - through a group as see-through as she is -
	# her side hair, the turns of gauze behind her, those in front, the gauze that hangs in front of her
	world_t = Node2D.new(); world_t.position = world.position; world_t.scale = world.scale; root_t.add_child(world_t)
	shredn_t = Node2D.new(); world_t.add_child(shredn_t)
	figure_t = CanvasGroup.new(); figure_t.fit_margin = figure.fit_margin; figure_t.clear_margin = figure.clear_margin; world_t.add_child(figure_t)
	var back_t := Node2D.new(); figure_t.add_child(back_t)
	var wb_t := Node2D.new(); figure_t.add_child(wb_t)
	var wf_t := Node2D.new(); figure_t.add_child(wf_t)
	var front_t := Node2D.new(); figure_t.add_child(front_t)
	for st in strands: twin_poly(st["poly"], back_t if st["fan"] else front_t, "mix+g", false)
	for w in wraps:
		twin_poly(w["polys"][0], wb_t, "strip+g", true); twin_poly(w["polys"][1], wf_t, "strip+g", true)
	for aw in armwraps:
		twin_poly(aw["polys"][0], wb_t, "strip+g", true); twin_poly(aw["polys"][1], wf_t, "strip+g", true)
	for sh in shreds:
		twin_poly(sh["polys"][0], shredn_t, "strip", true); twin_poly(sh["polys"][1], shredn_t, "strip", true)
	if sveils.size() > 0: sveils.append(veil_up(shredn_t))
	# the rings of her snap come at us: all of them in front of everything
	ring_t = Node2D.new(); root_t.add_child(ring_t)
	root_f.remove_child(ring); ring_t.add_child(ring)
	root_f.remove_child(ring2); ring_t.add_child(ring2)
	zdirty = true
	return true

func sync_top() -> void:
	# what is drawn in front of everything is the same picture again: every strip where its other self is
	world_t.position = world.position; world_t.modulate = world.modulate
	ring_t.modulate = root_f.modulate
	figure_t.scale = figure.scale; figure_t.position = figure.position; figure_t.self_modulate = figure.self_modulate
	# (the fog behind the characters has the dusk of the field over it: what of it is drawn over the interface is given the same)
	haze_mats[1].set_shader_parameter("wz_veil", veil.color)
	var outer: float = figure.self_modulate.a * SHOW
	for m in gmats: m.set_shader_parameter("wz_outer", outer)
	for pr in ptwins:
		var sp: Polygon2D = pr[0]
		var tp: Polygon2D = pr[1]
		if not sp.visible:
			if tp.visible: tp.visible = false
			continue
		if not tp.visible: tp.visible = true
		tp.polygon = sp.polygon
		if pr[2]: tp.vertex_colors = sp.vertex_colors

# ---- D. what moves is blurred a little (v0.47)
func soft_groups() -> bool:
	# (In the compatibility renderer a group is drawn through a buffer that keeps two bits of alpha - unless the
	#  window is see-through, or deep: nothing soft survives that. There, nothing is blurred.)
	if RenderingServer.get_current_rendering_method() != "gl_compatibility": return true
	var vp: Viewport = world.get_viewport()
	return vp != null and (vp.transparent_bg or vp.use_hdr_2d)

func veil_up(nd: Node) -> CanvasGroup:
	# this is drawn through a group of its own from now on (its material: wraith_veil.gdshader)
	var par: Node = nd.get_parent()
	var grp := CanvasGroup.new(); grp.fit_margin = 48.0; grp.clear_margin = 48.0
	par.add_child(grp); par.move_child(grp, nd.get_index())
	par.remove_child(nd); grp.add_child(nd)
	var m: ShaderMaterial = shader_mat("wraith_veil.gdshader")
	m.set_shader_parameter("own", 0.0)
	grp.material = m
	return grp

func pose_veil(t: float) -> void:
	# Her strips while they wait at the edges and whip in, the turns of gauze on their way round her: blurred, the
	# more the further from her they still are - what has come to lie on her is sharp, and so is all of her once
	# she stands. (She is drawn through a group already: it is that group's picture that is blurred.)
	if veil_state == -1:
		if not world.is_inside_tree(): return
		veil_state = 1 if soft_groups() else 0
	if veil_state != 1: return
	var since: float = t - SNAP
	var on: float = lerp(0.45 * WAKE, 1.0, sm(0.0, 0.12, t)) * (1.0 - sm(0.10, 0.60, since))
	if P["blur"] <= 0.01: on = 0.0
	if on > 0.004 and veil_mat == null:
		veil_mat = shader_mat("wraith_veil.gdshader")
		veil_mat.set_shader_parameter("core_a", Vector2(604, 400)); veil_mat.set_shader_parameter("core_b", Vector2(604, 1560))
		veil_mat.set_shader_parameter("near", 330.0); veil_mat.set_shader_parameter("far", 800.0)
		veil_mat.set_shader_parameter("own", 1.0)
	var want: Material = veil_mat if on > 0.004 else null
	if on > 0.004: veil_mat.set_shader_parameter("blur", float(P["blur"]) * BLUR_PX * KK * on)
	if figure.material != want: figure.material = want
	if figure_t != null and figure_t.material != want: figure_t.material = want
	# the shreds thrown off as she snaps open
	if P["blur"] > 0.01 and since >= 0.0 and since < 0.50:
		if sveils.size() == 0:
			sveils.append(veil_up(shredn))
			if shredn_t != null: sveils.append(veil_up(shredn_t))
		for grp in sveils: grp.material.set_shader_parameter("blur", float(P["blur"]) * BLUR_PX * KK * 0.9)

func times() -> PackedFloat32Array:
	return PackedFloat32Array([SNAP, SNAP + 0.30, SNAP + 0.95])

func phase() -> PackedFloat32Array:
	return PackedFloat32Array([PH, breath])
