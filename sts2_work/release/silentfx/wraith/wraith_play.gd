		var foot2 = Vector2(L[key2]["foot"][0], L[key2]["foot"][1])
		var tl := []
		for j in range(TAILN):
			var tn = Node2D.new(); trail_back.add_child(tn); tl.append(tn)
			var tf = sprite(L[key2]); tf.position -= foot2 - Vector2(0, 100); tn.add_child(tf)
		tails.append(tl)
		var hn = Node2D.new(); trail_back.add_child(hn); heads.append(hn)
		var hf = sprite(L[key2]); hf.position -= foot2 - Vector2(0, 100); hn.add_child(hf)
		var hg2 = Sprite2D.new(); hg2.texture = gt; hg2.material = addm; hg2.scale = Vector2(2.2, 2.2); hg2.modulate = Color(0.5, 1.0, 0.45, 0.7); hg2.visible = false; fglow_b.add_child(hg2); fglow.append(hg2)
	chest_flash = Sprite2D.new(); chest_flash.texture = gt; chest_flash.material = addm; stage_f.add_child(chest_flash)
	built = true
	TT = -1.0; CL = 0.0
	X = x_at(TT)
	pose()
	return true

func fire_ways() -> void:
	# The way the thrown fire goes: on from the tips of her blades the way they were going as it left them - up and
	# in over her -, back across behind her head (the two of them cross there), on to the far side, smaller and
	# slower; and down that side, back towards us, into the one who played her. It goes the way her blades point,
	# as high as that takes it: it is drawn under the interface, so the top bar hides what of it passes behind that.
	# It only keeps to the window itself - in from its top and its sides.
	fire_dirty = false
	fpath.clear(); frel.clear()
	var keep = X
	var sc2: float = P["sc"]
	var mid: float = 960.0 / sc2
	var pk: float = stage_b.scale.x
	var high: float = VHI.y - VLO.y
	# (the highest the middle of it may go, and how far out, in the stages' own space)
	var ceil_y: float = (VLO.y + float(P["fire_pad"]) * high - BASE.y) / pk
	var left_x: float = (VLO.x + 0.035 * high - BASE.x) / pk
	var right_x: float = (VHI.x - 0.035 * high - BASE.x) / pk
	var soft: float = 0.04 * high / pk
	for i in range(2):
		var sgn2: float = -1.0 if i == 0 else 1.0
		var t1p: Vector2 = tip_at(T_REL, i)
		var t0p: Vector2 = tip_at(T_REL - 0.10, i)
		var vr: Vector2 = (t1p - t0p).normalized()
		frel.append(vr)
		var room: float = ((VHI.x - BASE.x) / pk - mid) if sgn2 < 0.0 else (mid - (VLO.x - BASE.x) / pk)
		var fitx: float = clamp(room / (590.0 / sc2), 0.45, 1.0)
		var top_y: float = max(66.0 / sc2, ceil_y)
		var lowd: float = smoothstep(0.0, 90.0 / sc2, top_y - 66.0 / sc2)        # (how much the top of its way has had to come down)
		var p1: Vector2 = t1p + vr * lerp(250.0, 120.0, lowd)
		if lowd > 0.0: p1.y = max(p1.y, top_y + 14.0 / sc2)
		var y4: float = top_y + 134.0 / sc2
		var way = [t1p, p1, Vector2(mid - sgn2 * fitx * 40.0 / sc2, top_y + lerp(46.0, 8.0, lowd) / sc2), Vector2(mid - sgn2 * fitx * 270.0 / sc2, top_y), Vector2(mid - sgn2 * fitx * 470.0 / sc2, y4),
			Vector2(mid - sgn2 * fitx * 520.0 / sc2, max(430.0 / sc2, y4 + 170.0 / sc2)), Vector2(mid - sgn2 * fitx * 340.0 / sc2, max(690.0 / sc2, y4 + 330.0 / sc2)) + WHOX * 0.6, Vector2(mid - sgn2 * fitx * 45.0 / sc2, 775.0 / sc2) + WHOX]
		var nseg: int = way.size() - 1
		# (stepped evenly along its length, so that how fast it goes is fmap's to say)
		var fine := PackedVector2Array()
		for q in range(601):
			var wf: float = float(q) / 600.0 * nseg
			var wk: int = min(int(floor(wf)), nseg - 1)
			var wt: float = wf - wk
			var p0: Vector2 = way[max(wk - 1, 0)]; var pa: Vector2 = way[wk]; var p2: Vector2 = way[wk + 1]; var p3: Vector2 = way[min(wk + 2, nseg)]
			var pt: Vector2 = 0.5 * ((2.0 * pa) + (-p0 + p2) * wt + (2.0 * p0 - 5.0 * pa + 4.0 * p2 - p3) * wt * wt + (-p0 + 3.0 * pa - 3.0 * p2 + p3) * wt * wt * wt)
			# (whatever the curve does between its points: it is turned back, softly, before it leaves the screen)
			if pt.y < ceil_y + soft: pt.y = ceil_y + soft * exp((pt.y - ceil_y - soft) / soft)
			pt.x = clamp(pt.x, left_x, right_x)
			fine.append(pt)
		var acl := PackedFloat32Array(); acl.resize(601); acl[0] = 0.0
		for q in range(1, 601): acl[q] = acl[q - 1] + fine[q].distance_to(fine[q - 1])
		var wpts := PackedVector2Array()
		var qq := 0
		var top := 0; var topy := 1e18
		for q in range(101):
			var want: float = acl[600] * float(q) / 100.0
			while qq < 599 and acl[qq + 1] < want: qq += 1
			var pt2: Vector2 = fine[qq].lerp(fine[qq + 1], clamp((want - acl[qq]) / max(acl[qq + 1] - acl[qq], 0.001), 0.0, 1.0))
			wpts.append(pt2)
			if pt2.distance_to(way[3]) < topy:
				topy = pt2.distance_to(way[3]); top = q
		APEX = float(top) / 100.0
		if P["probe"] > 0.5: print("fire ", i, " apex ", APEX, " len ", acl[600] * sc2, " ceil ", ceil_y * pk + BASE.y, " top of it ", way[3] * pk + BASE)
		fpath.append(wpts)
	X = keep

func set_time(t: float, clock: float) -> void:
	if not built: return
	if topped and not is_instance_valid(stage_t):
		# (the layer in front of everything has been taken away under her: what was on it is gone, and she stops)
		built = false
		return
	TT = t; CL = clock
	if zdirty: zone_numbers()
	if fire_dirty: fire_ways()
	X = x_at(TT)
	pose()
	# her own shake (the screen's is the game's to give): a knock as the light lands in her, a heave as she
	# bursts, a tremble while she screams
	var s2 = TT - T_GO; var s3 = TT - T_BURST
	var shk = 0.0
	if s3 > 0.0: shk += 5.0 * exp(-s3 / 0.05)
	if s2 > 0.0: shk += 13.0 * exp(-s2 / 0.24) + 1.5 * (1.0 - sm(1.9, 2.6, s2))
	var off = Vector2(sin(TT * 97.0), cos(TT * 71.0)) * (shk * P["shake"] * P["sc"] * KK)
	stage_b.position = BASE + off; stage_f.position = BASE + off
	if stage_t != null: stage_t.position = BASE + off

func set_fade(a: float) -> void:
	FADE = clamp(a, 0.0, 1.0)
	if not built: return
	stage_b.modulate = Color(1, 1, 1, FADE); stage_f.modulate = Color(1, 1, 1, FADE)
	if stage_t != null: stage_t.modulate = Color(1, 1, 1, FADE)

func set_param(key: String, value: float) -> void:
	P[key] = value
	if key.begins_with("ui_") or key == "fire_pad":
		zdirty = true; fire_dirty = true

# ---- B. what of her lies where the game's own interface is, is drawn over the interface (v0.47)
# The interface takes up bands of the window: one along the top (the bar, the relics under it), one along the bottom
# (the hand), and the two bottom corners up to a little higher (energy and the piles; the end of the turn). No
# character stands there. Every piece of her that can come to lie in them is drawn twice - where it always was,
# among the rest of her, behind the characters; and again on a stage in front of everything - and each of the two
# shows of every point only its share, by where that point is on the screen: in the middle of the field all of it
# is the first one's, in the bands all of it the second's, across a soft edge between them a share each - shares
# that together are the piece drawn once, exactly (wz_a below).
const WZ_HEAD := """uniform vec4 wz_y = vec4(-2.0e9, -1.0e9, 1.0e9, 2.0e9);
uniform vec4 wz_c = vec4(-2.0e9, 2.0e9, 2.0e9, 1.0);
uniform float wz_side = 0.0;
uniform float wz_outer = 1.0;
uniform float wz_gain = 1.0;
uniform vec4 wz_veil = vec4(0.0);
varying vec2 wz_p;
float wz_a(float a) {
	float w = max(1.0 - smoothstep(wz_y.x, wz_y.y, wz_p.y), smoothstep(wz_y.z, wz_y.w, wz_p.y));
	float cx = max(1.0 - smoothstep(wz_c.x - wz_c.w, wz_c.x + wz_c.w, wz_p.x), smoothstep(wz_c.y - wz_c.w, wz_c.y + wz_c.w, wz_p.x));
	w = max(w, cx * smoothstep(wz_c.z - wz_c.w, wz_c.z + wz_c.w, wz_p.y)) * wz_gain;
	if (wz_side > 0.5) return a * w;
#ifdef WZ_ADD
	return a * (1.0 - w);
#else
	return a * (1.0 - w) / max(1.0 - wz_outer * a * w, 0.0001);
#endif
}
"""

func zoned(code: String, add: bool) -> Shader:
	# a shader of hers, made to draw only its share of every point (see above). The share is the last thing its
	# fragment() works out; where the point is on the screen, the first thing its vertex() does.
	var key = "shz:" + str(code.hash()) + ("+" if add else "")
	if CACHE.has(key): return CACHE[key]
	var c := code
	var f: int = c.find("void fragment()")
	var e := -1
	if f >= 0:
		var depth := 0
		var j: int = c.find("{", f)
		while j >= 0 and j < c.length():
			var ch: String = c[j]
			if ch == "{": depth += 1
			elif ch == "}":
				depth -= 1
				if depth == 0:
					e = j
					break
			j += 1
	if e >= 0:
		c = c.substr(0, e) + "\tCOLOR.rgb = mix(COLOR.rgb, wz_veil.rgb, wz_veil.a);\n\tCOLOR.a = wz_a(COLOR.a);\n" + c.substr(e)
		if c.find("void vertex() {") >= 0: c = c.replace("void vertex() {", "void vertex() {\n\twz_p = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;")
		else: c += "\nvoid vertex() {\n\twz_p = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;\n}\n"
		c = c.replace("shader_type canvas_item;", "shader_type canvas_item;\n" + ("render_mode blend_add;\n#define WZ_ADD\n" if add else "") + WZ_HEAD)
	if e < 0 or c.find("wz_a(COLOR.a)") < 0 or c.find("uniform vec4 wz_y") < 0: push_error("Wraith Form: a shader of hers could not be made to share itself with the layer in front - it will be drawn twice")
	var sh := Shader.new(); sh.code = c
	CACHE[key] = sh
	return sh

func zone_mat(kind: String, side: int) -> ShaderMaterial:
	# for a plain picture ("mix"), or a light ("add"): its share behind the interface (0) or over it (1)
	var key = kind + str(side)
	if ZM.has(key): return ZM[key]
	var m := ShaderMaterial.new()
	m.shader = zoned("shader_type canvas_item;\nvoid fragment() {\n}\n", kind == "add")
	m.set_shader_parameter("wz_side", float(side))
	ZM[key] = m; zmats.append(m)
	return m

func zone_numbers() -> void:
	# where the bands of the interface are, in the scene's own coordinates (the mod says what part of the window
	# they take up: "ui_top" - the top band down to there; "ui_bot" - the bottom band from there; "ui_left",
	# "ui_right", "ui_corner" - the bottom corners: left of / right of / below; "ui_soft" - how wide the edge is)
	zdirty = false
	var high: float = VHI.y - VLO.y
	var wide: float = VHI.x - VLO.x
	var s: float = max(float(P["ui_soft"]), 0.002) * high * 0.5
	var zy := Vector4(-2.0e9, -1.0e9, 1.0e9, 2.0e9)
	if P["ui_top"] > 0.0:
		zy.x = VLO.y + P["ui_top"] * high - s; zy.y = zy.x + 2.0 * s
	if P["ui_bot"] < 1.0:
		zy.z = VLO.y + P["ui_bot"] * high - s; zy.w = zy.z + 2.0 * s
	var zc := Vector4(-2.0e9, 2.0e9, 2.0e9, s)
	if P["ui_corner"] < P["ui_bot"]:
		zc.z = VLO.y + P["ui_corner"] * high
		if P["ui_left"] > 0.0: zc.x = VLO.x + P["ui_left"] * wide
		if P["ui_right"] < 1.0: zc.y = VLO.x + P["ui_right"] * wide
	for m in zmats:
		m.set_shader_parameter("wz_y", zy); m.set_shader_parameter("wz_c", zc)

func zone_pair(s: CanvasItem, t: CanvasItem) -> void:
	# a piece of her and its other self in front of everything: between them they show each point of it once
	var m = s.material
	if m is ShaderMaterial:
		var sh: Shader = m.shader
		var zs: Shader = zoned(sh.code, false)
		var lo := ShaderMaterial.new(); lo.shader = zs
		var hi := ShaderMaterial.new(); hi.shader = zs
		for u in sh.get_shader_uniform_list():
			var v = m.get_shader_parameter(u["name"])
			if v != null:
				lo.set_shader_parameter(u["name"], v); hi.set_shader_parameter(u["name"], v)
		hi.set_shader_parameter("wz_side", 1.0)
		zmats.append(lo); zmats.append(hi)
		s.material = lo; t.material = hi
		var k: int = fire_mats.find(m)
		if k >= 0:
			fire_mats[k] = lo; fire_mats_t[k] = hi
	elif m != null and m == addm:
		s.material = zone_mat("add", 0); t.material = zone_mat("add", 1)
	elif m == null and (s is Sprite2D or s is Polygon2D):
		s.material = zone_mat("mix", 0); t.material = zone_mat("mix", 1)

func twin_tree(src: Node, par_t: Node) -> void:
	var t: Node = src.duplicate(0)
	par_t.add_child(t)
	twin_walk(src, t)

func twin_walk(s: Node, t: Node) -> void:
	if s is Node2D:
		twins.append([s, t])
		zone_pair(s, t)
	for i in range(s.get_child_count()): twin_walk(s.get_child(i), t.get_child(i))

func twin_poly(src: Polygon2D, par_t: Node) -> void:
	var tp := Polygon2D.new(); tp.texture = src.texture; tp.polygon = src.polygon; tp.uv = src.uv; tp.polygons = src.polygons
	tp.visible = false; par_t.add_child(tp)
	src.material = zone_mat("mix", 0); tp.material = zone_mat("mix", 1)
	ptwins.append([src, tp])

func set_top(p_top: Node) -> bool:
	# A stage in front of everything (the mod puts it over the game's own interface).
	if not built or p_top == null or stage_t != null: return false
	TOPN = p_top
	stage_t = Node2D.new(); stage_t.scale = stage_b.scale; stage_t.position = stage_b.position; stage_t.modulate = stage_b.modulate
	p_top.add_child(stage_t)
	topped = true
	figure_t = Node2D.new(); figure_t.scale = figure.scale; figure_t.position = figure.position; stage_t.add_child(figure_t)
	# in the order she is drawn in: her side hair; her blades of fire; her skull and her horns; the bands wound on
	# her and the gauze that hangs in front; the fire of her eye; the rings of her scream
	back_t = Node2D.new(); figure_t.add_child(back_t)
	for i in range(2): twin_tree(grip[i], figure_t)
	twin_tree(skulln, figure_t)
	for h in horns: twin_tree(h, figure_t)
	bodyr_t = Node2D.new(); figure_t.add_child(bodyr_t)
	frontn_t = Node2D.new(); figure_t.add_child(frontn_t)
	twin_tree(eye, figure_t)
	for st in strands:
		var par: Node = back_t if st["fan"] else frontn_t
		for gp in st["ghosts"]: twin_poly(gp, par)
		twin_poly(st["poly"], par)
	for bs in bstrands:
		for bp in bs["polys"]: twin_poly(bp, bodyr_t)
	if veil_state == 1:
		veils.append(veil_up([back_t])); veils.append(veil_up([bodyr_t, frontn_t]))
	# her scream comes at us: all of every ring is in front of everything
	for r in rings: figure.remove_child(r); figure_t.add_child(r)
	figure.remove_child(cone); figure_t.add_child(cone)
	for r2 in rings2: figure.remove_child(r2); figure_t.add_child(r2)
	zdirty = true
	return true

func sync_top() -> void:
	# what is drawn in front of everything is the same picture again: every piece where its other self is
	for pr in twins:
		var s: Node2D = pr[0]
		var t: Node2D = pr[1]
		if not s.visible:
			if t.visible: t.visible = false
			continue
		if not t.visible: t.visible = true
		t.transform = s.transform; t.modulate = s.modulate; t.self_modulate = s.self_modulate
	for pr2 in ptwins:
		var sp: Polygon2D = pr2[0]
		var tp: Polygon2D = pr2[1]
		if not sp.visible:
			if tp.visible: tp.visible = false
			continue
		if not tp.visible: tp.visible = true
		tp.polygon = sp.polygon; tp.color = sp.color

# ---- D. what moves is blurred a little (v0.47): her strips while the wind has them, her thrown fire
func soft_groups() -> bool:
	# (In the compatibility renderer a group is drawn through a buffer that keeps two bits of alpha - unless the
	#  window is see-through, or deep: nothing soft survives that. There, nothing is blurred.)
	if RenderingServer.get_current_rendering_method() != "gl_compatibility": return true
	var vp: Viewport = stage_b.get_viewport()
	return vp != null and (vp.transparent_bg or vp.use_hdr_2d)

func veil_up(nodes: Array) -> CanvasGroup:
	# these (they follow one another in what holds them) are drawn through a group of their own from now on
	var first: Node = nodes[0]
	var par: Node = first.get_parent()
	var grp := CanvasGroup.new(); grp.fit_margin = 48.0; grp.clear_margin = 48.0
	par.add_child(grp); par.move_child(grp, first.get_index())
	for nd in nodes:
		par.remove_child(nd); grp.add_child(nd)
	var m: ShaderMaterial = shader_mat("wraith_veil.gdshader")
	m.set_shader_parameter("own", 0.0)
	grp.material = m
	return grp

func pose_veils() -> void:
	# her strips: sharp where they lie on her, blurred the more the further the wind has carried them
	var wind: float = sm(0.0, 0.30, TT - T_GO)
	if veil_state == -1 and wind > 0.0 and stage_b.is_inside_tree():
		veil_state = 0
		if P["blur"] > 0.01 and soft_groups():
			veil_state = 1
			veils.append(veil_up([back])); veils.append(veil_up([bodyr, frontn]))
			if stage_t != null:
				veils.append(veil_up([back_t])); veils.append(veil_up([bodyr_t, frontn_t]))
	if veil_state != 1: return
	var bl: float = float(P["blur"]) * BLUR_PX * KK * wind
	for grp in veils:
		var m: ShaderMaterial = grp.material
		m.set_shader_parameter("blur", bl)
		m.set_shader_parameter("core_a", M2); m.set_shader_parameter("core_b", M2)
		m.set_shader_parameter("near", 300.0); m.set_shader_parameter("far", 1000.0)

func pose_fire_veils(fl: float) -> void:
	# her thrown fire: blurred by how fast it is going (at the top of its way, where it all but hangs, it is sharp)
	if fl < 0.0 or fl >= 1.0: return
	if fveil_state == -1 and stage_b.is_inside_tree():
		fveil_state = 0
		if P["blur"] > 0.01 and soft_groups():
			fveil_state = 1
			fveils.append(veil_up([trail_back])); fveils.append(veil_up([trail_front]))
	if fveil_state != 1: return
	var fast: float = clamp((fmap(fl + 0.012) - fmap(fl - 0.012)) / 0.024, 0.0, 2.4)
	var bl: float = float(P["blur"]) * KK * (0.8 + 1.9 * fast)
	for grp in fveils:
		var m: ShaderMaterial = grp.material
		m.set_shader_parameter("blur", bl)

# ---- the first wave of her scream pushes the picture aside as it passes (v0.47)
const WAVE_LAST := 0.90          # how long it takes to leave the screen

func pose_wave() -> void:
	var s: float = TT - T_GO
	if P["wave"] <= 0.01 or s <= 0.0 or s >= WAVE_LAST:
		if wave != null and wave.visible: wave.visible = false
		return
	if wave == null:
		# (in front of everything, if there is such a place: the game's own interface is pushed aside with the rest)
		var par: Node = TOPN if stage_t != null else FRONTN
		if par == null: return
		wave = ColorRect.new(); wave.mouse_filter = Control.MOUSE_FILTER_IGNORE; wave.position = VLO; wave.size = VHI - VLO; wave.color = Color(1, 1, 1, 0)
		wave_mat = shader_mat("wraith_wave.gdshader"); wave.material = wave_mat
		wave_mat.set_shader_parameter("aspect", (VHI.x - VLO.x) / max(VHI.y - VLO.y, 1.0))
		# (it must read the screen as it is when this is drawn)
		var bb := BackBufferCopy.new(); bb.copy_mode = BackBufferCopy.COPY_MODE_VIEWPORT; bb.show_behind_parent = true; wave.add_child(bb)
		par.add_child(wave)
	if not wave.visible: wave.visible = true
	var mouth: Vector2 = stage_b.position + (figure.transform * M2) * stage_b.scale.x
	var front: float = 1.5 * s
	wave_mat.set_shader_parameter("centre", (mouth - VLO) / (VHI - VLO))
	wave_mat.set_shader_parameter("front", front)
	wave_mat.set_shader_parameter("strength", P["wave_push"])
	wave_mat.set_shader_parameter("power", clamp(float(P["wave"]), 0.0, 3.0) * sm(0.0, 0.05, s) * (1.0 - sm(WAVE_LAST - 0.30, WAVE_LAST, s)) / (1.0 + 0.8 * front) * FADE)

func times() -> PackedFloat32Array:
	return PackedFloat32Array([T_BURST, T_GO, T_HIT, T_GO + 3.05])

func chest() -> Vector2:
	if not built: return Vector2.ZERO
	return BASE + (OFF + CHEST) * (P["sc"] * KK)
