func tex(nm: String) -> Texture2D:
	# (kept from one playing of the card to the next: the mod owns the cache)
	var key = ("tex2/" + nm) if not nm.begins_with("../") else nm.substr(3)
	if CACHE.has(key): return CACHE[key]
	var img = Image.load_from_file(DIR + "/" + key)
	var t = ImageTexture.create_from_image(img)
	CACHE[key] = t
	return t

func shader_mat(file: String) -> ShaderMaterial:
	var key = "sh:" + file
	var sh: Shader
	if CACHE.has(key): sh = CACHE[key]
	else:
		sh = Shader.new(); sh.code = FileAccess.get_file_as_string(DIR + "/" + file)
		CACHE[key] = sh
	var m = ShaderMaterial.new(); m.shader = sh
	return m

func hash1(i: int) -> float:
	var x = sin(float(i) * 12.9898) * 43758.5453
	return x - floor(x)

func sprite(layer) -> Sprite2D:
	var s = Sprite2D.new(); s.texture = tex(layer["tex"]); s.centered = false
	s.position = Vector2(layer["ox"], layer["oy"])
	if layer.has("k"): s.scale = Vector2.ONE / float(layer["k"])
	return s

func light(layer, at: Vector2) -> Sprite2D:
	# a light of her marks, laid where its part's own corner is "at"
	var s = sprite(layer); s.position -= at; s.material = addm
	glows.append(s)
	return s

# ---- the three moves
# (the numbers of her pose that every point of her hair asks for: worked out once a frame, in pose())
var HB := 0.0                    # her breath
var H_ct := 1.0                  # her head: the cosine and sine of how far it is thrown back,
var H_st := 0.0
var H_nod := 0.0                 # its nod (radians), how much nearer it is, how far her neck is drawn out
var H_s := 1.0
var H_rise := 0.0

func frame_numbers() -> void:
	HB = X["breath"]
	var th: float = deg_to_rad(X["tilt"])
	H_ct = cos(th); H_st = sin(th)
	H_nod = deg_to_rad(X["nod"])
	H_s = X["head_s"]; H_rise = X["rise"]

func d_breath(p: Vector2) -> Vector2:
	var dx: float = p.x - CHEST.x
	var dy: float = p.y - CHEST.y
	var k: float = SWELL * HB * exp(-(dx * dx) / 28900.0 - (dy * dy) / 40000.0)
	return Vector2(dx * k, dy * k - LIFT * HB * smoothstep(CHEST.y + 90.0, CHEST.y - 130.0, p.y))

func head_w(p: Vector2) -> float:
	return 1.0 - smoothstep(HR * 0.80, HR * 1.30, (p - HC).length())

func head_z(p: Vector2) -> float:
	var r2: float = (p - HC).length_squared()
	return HZ * max(0.0, 1.0 - r2 / (HR * HR))

func head_rigid(p: Vector2, z: float) -> Vector2:
	var yr: float = NECK.y - p.y
	var y2: float = yr * H_ct + z * H_st
	var z2: float = -yr * H_st + z * H_ct
	var q := Vector2(NECK.x + (p.x - NECK.x) * (1.0 + z2 / 1600.0), NECK.y - y2)
	if H_nod != 0.0: q = NECK + (q - NECK).rotated(H_nod)
	q = NECK + (q - NECK) * H_s
	q.y -= H_rise
	return q

func d_head(p: Vector2) -> Vector2:
	return (head_rigid(p, head_z(p)) - p) * head_w(p)

func sleeve_k(p: Vector2, i: int) -> float:
	var sh: Vector2 = SH[i]; var fist: Vector2 = FISTS[i]
	var a = fist - sh
	var len = a.length()
	a /= len
	var d = p - sh
	var t = d.dot(a) / len
	var side = abs(d.x * a.y - d.y * a.x)
	var near = 1.0 - smoothstep(110.0, 170.0, side)
	var outer = (1.0 - smoothstep(sh.x + 10.0, sh.x + 70.0, p.x)) if fist.x < sh.x else smoothstep(sh.x - 70.0, sh.x - 10.0, p.x)
	return smoothstep(0.0, 0.5, t) * near * outer

func sleeve_ang(i: int) -> float:
	return deg_to_rad(X["sleeve"]) * (1.0 if i == 0 else -1.0)

func d_sleeve(p: Vector2, i: int) -> Vector2:
	var sh: Vector2 = SH[i]
	return (sh + (p - sh).rotated(sleeve_ang(i) * sleeve_k(p, i))) - p

func where(p: Vector2) -> Vector2:
	return p + d_breath(p) + d_head(p) + d_sleeve(p, 0) + d_sleeve(p, 1)

# ---- her hair
func normal_at(p: PackedVector2Array, i: int) -> Vector2:
	var n = p.size()
	var t: Vector2
	if i == 0: t = p[1] - p[0]
	elif i == n - 1: t = p[n - 1] - p[n - 2]
	else: t = p[i + 1] - p[i - 1]
	t = t.normalized()
	return Vector2(-t.y, t.x)

func strip(p: PackedVector2Array, st: Dictionary, k: float = 1.0) -> PackedVector2Array:
	# the two edges of a strip about its middle line (st: whose widths; k: times this)
	var n: int = p.size()
	var left: PackedFloat32Array = st["left"]
	var right: PackedFloat32Array = st["right"]
	var v := PackedVector2Array(); v.resize(n * 2)
	for i in range(n):
		var t: Vector2
		if i == 0: t = p[1] - p[0]
		elif i == n - 1: t = p[n - 1] - p[n - 2]
		else: t = p[i + 1] - p[i - 1]
		t = t.normalized()
		var nr := Vector2(-t.y, t.x)
		var pi: Vector2 = p[i]
		v[2 * i] = pi + nr * (left[i] * k)
		v[2 * i + 1] = pi - nr * (right[i] * k)
	return v

# ---- her gauze is BLOWN off her (v0.47). Her scream is the cause, and the middle of it is her mouth. From the
# moment she starts to scream a wind goes out from there. A first wave of it runs out (what is near her mouth feels
# it first: a knock); then it builds, slowly: the free end of every strip lifts and comes round to point away from
# her mouth, flutters harder and harder, is drawn taut - and then, the outermost first, a strip tears off at its
# ROOT and is carried straight out the way it was pointing, its free end first, faster and faster. Nothing of it
# ever goes one way and then another.
const FLY_DUR := 0.52            # how long a strip that has torn off is in the air
const FLY_FAR := 1750.0          # ... and how far it is carried (her own pixels)
const FLY_LAG := 0.14            # its root comes this much (of that time) after its free end: it is drawn out long as it goes
const FLUT := 0.50               # how far the wind throws its turns about as it flutters (radians)
const FLUT_K := TAU / 250.0      # one wave of that along it (her own pixels),
const FLUT_W := TAU * 6.5        # ... and in time
const BAND_LIFT := 0.26          # a band wound on her body shows this long before it tears off, lifting
const PUFF_DUR := 0.36           # the dust where a strip tears loose
const BLUR_PX := 5.0             # how far what moves is blurred where it is blurred most (pixels of a 1080 screen; times "blur")

func lift_of(st: Dictionary, t: float) -> float:
	# How far the wind has brought a strip round by time t: 0 - it hangs as it did; 1 - it streams straight away
	# from her mouth, taut (and tears off).
	var ts: float = T_GO + float(st["far"]) / WAVEC                # (the first wave reaches it)
	if t <= ts: return 0.0
	var u: float = clamp((t - ts) / max(float(st["tear"]) - ts, 0.02), 0.0, 1.0)
	var x: float = (t - ts) / 0.07
	# the knock of the wave as it passes, then the wind itself: slowly at first, hard at the end
	return min(1.0, 0.20 * u + 0.80 * u * u * u + 0.22 * x * exp(1.0 - x) * (1.0 - u))

func wind_of(st: Dictionary, rest: PackedVector2Array, dep: int, out_x: float, sd: int) -> void:
	# Which way the wind carries a strip: away from her mouth, from where most of the strip lies (a little up, and
	# to its own side: nothing goes straight down behind the one who plays her, nor straight up through her horns).
	var n: int = st["n"]
	var c := Vector2.ZERO
	for i in range(dep, n): c += rest[i]
	c /= float(max(n - dep, 1))
	st["far"] = c.distance_to(MOUTH)
	var wd: float = (c - MOUTH + Vector2(out_x * 60.0, -70.0)).angle() + (hash1(sd * 11 + 4) - 0.5) * 0.30
	st["wd"] = wd
	var dl: float = angle_difference((rest[n - 1] - rest[dep]).angle(), wd)
	# (it comes round the short way; hanging almost against the wind, by its own side - outwards)
	st["wsg"] = (-out_x) if absf(dl) > 2.4 else (1.0 if dl >= 0.0 else -1.0)
	st["bow"] = (hash1(sd * 11 + 5) - 0.5) * 0.44
	st["wph"] = TAU * hash1(sd * 11 + 6)
	st["curl"] = (hash1(sd * 11 + 7) - 0.5) * 240.0
	st["tear"] = T_PULL + float(st["order"]) * PULL_SPAN
	st["puff_on"] = false
	var pf := []
	for q in range(3):
		var sp = Sprite2D.new(); sp.texture = gtex; sp.material = addm; sp.visible = false; puffn.add_child(sp); pf.append(sp)
	st["puffs"] = pf

func wind_turn(st: Dictionary, was: PackedVector2Array, res: PackedVector2Array, lam: float, bend: float) -> void:
	# From where a strip is held, on to its free end: every turn of it brought round towards the way the wind goes -
	# the free end first, its root last -, and thrown about as it flutters. No turn of it is made longer or shorter.
	# (was: the strip as it would lie without the wind; res: filled from st["dep"] on; bend: what her own moving bends it by)
	var n: int = st["n"]
	var dep: int = st["dep"]
	var arc: PackedFloat32Array = st["arc"]
	var arc0: float = st["arc0"]
	var span: float = st["span"]
	var wd: float = st["wd"]; var wsg: float = st["wsg"]; var bow: float = st["bow"]; var sph: float = st["wph"]
	var fa: float = FLUT * lam * (1.0 - 0.6 * lam * lam * lam)
	for i in range(dep, n - 1):
		var s: float = arc[i] - arc0
		var u: float = clamp(s / span, 0.0, 1.0)
		var seg: Vector2 = was[i + 1] - was[i]
		var a0: float = seg.angle() + bend * pow(u, 0.75)
		var dl: float = angle_difference(a0, wd + bow * (u - 0.5))
		if dl * wsg < 0.0 and absf(dl) > 1.9: dl += wsg * TAU
		var f: float = pow(lam, 1.0 + 1.8 * (1.0 - u)) * min(1.0, 0.25 + u / 0.10)
		var a: float = a0 + dl * f + fa * u * sin(FLUT_K * s - FLUT_W * TT + sph)
		res[i + 1] = res[i] + Vector2(cos(a), sin(a)) * seg.length()

func torn_of(st: Dictionary) -> PackedVector2Array:
	# A strip as it was at the instant it tore off (worked out once, from her pose at that instant - whatever
	# time it is now: it does not depend on what was drawn before).
	if st.has("torn") and st["torn_ph"] == P["ph"]: return st["torn"]
	var keep = X; var keept: float = TT; var keepm: Vector2 = M2
	TT = st["tear"]
	X = x_at(TT); frame_numbers()
	M2 = head_rigid(MOUTH, head_z(MOUTH)) + d_breath(HC)
	var res: PackedVector2Array = pose_strand(st)
	st["torn"] = res; st["torn_ph"] = P["ph"]
	TT = keept; X = keep; frame_numbers(); M2 = keepm
	return res

func lift_band(bs: Dictionary, lam: float) -> PackedVector2Array:
	# a band wound on her body, as the wind gets under it
	var rest: PackedVector2Array = bs["rest"]
	if lam <= 0.0: return rest
	var res := PackedVector2Array(); res.resize(int(bs["n"]))
	for i in range(int(bs["dep"]) + 1): res[i] = rest[i]
	wind_turn(bs, rest, res, lam, 0.0)
	return res

func fly(st: Dictionary, torn: PackedVector2Array, tau: float) -> PackedVector2Array:
	# A strip that has torn off, tau seconds on: carried straight out the way it pointed, its free end first - so it
	# is drawn out long as it goes -, faster and faster. What of it lay on her head falls into line behind the rest;
	# the end that has just been let go whips once; all of it flutters, and drifts a little to one side.
	var n: int = st["n"]
	var dep: int = st["dep"]
	var arc: PackedFloat32Array = st["arc"]
	var arc0: float = st["arc0"]
	var span: float = st["span"]
	var wd: float = st["wd"]
	var dir := Vector2(cos(wd), sin(wd))
	var nrm := Vector2(-dir.y, dir.x)
	var sph: float = st["wph"]
	var curl: float = st["curl"]
	var whip: float = 30.0 * exp(-tau / 0.10) * sin(TAU * 7.0 * tau)
	var grow: float = smoothstep(0.0, 0.12, tau)
	var line: float = smoothstep(0.0, 0.11, tau)
	var root: Vector2 = torn[dep]
	var k: float = 1.0 / (FLY_DUR * (1.0 - FLY_LAG))
	var out := PackedVector2Array(); out.resize(n)
	for i in range(n):
		var s: float = arc[i] - arc0
		var v: float = clamp(s / span, 0.0, 1.0)
		var x: float = clamp((tau - FLY_DUR * FLY_LAG * (1.0 - v)) * k, 0.0, 1.0)
		var d: float = FLY_FAR * x * x * (0.35 + 0.65 * x)
		var side: float = grow * (8.0 + 12.0 * (1.0 - v)) * sin(FLUT_K * s - FLUT_W * tau + sph + 1.3) + whip * (1.0 - v) * (1.0 - v) + curl * x * x
		var at: Vector2 = torn[i]
		if i < dep: at = at.lerp(root + dir * s, line)
		out[i] = at + dir * d + nrm * side
	return out

func puff(st: Dictionary, tau: float) -> void:
	# a breath of dust where a strip tears loose: soft, lit by her own light, carried off the same way and gone
	var on: bool = tau >= 0.0 and tau < PUFF_DUR and P["puff"] > 0.01
	if not on:
		if st["puff_on"]:
			st["puff_on"] = false
			for sp0 in st["puffs"]: sp0.visible = false
		return
	st["puff_on"] = true
	var torn: PackedVector2Array = st["torn"]
	var at: Vector2 = torn[int(st["dep"])]
	var wd: float = st["wd"]
	var dir := Vector2(cos(wd), sin(wd))
	var nrm := Vector2(-dir.y, dir.x)
	var y: float = tau / PUFF_DUR
	var e: float = 1.0 - (1.0 - y) * (1.0 - y)
	var a: float = float(P["puff"]) * 0.42 * pow(1.0 - y, 1.3) * min(tau / 0.03, 1.0)
	var sd: int = int(st["idx"]) * 7
	var q := 0
	for sp in st["puffs"]:
		var h: float = hash1(sd + q * 3 + 1)
		var h2: float = hash1(sd + q * 3 + 2)
		sp.visible = true
		sp.position = at + dir * ((30.0 + 330.0 * h) * e) + nrm * ((h2 - 0.5) * 150.0 * e)
		var sc: float = (0.22 + 0.34 * h2) * (0.5 + 1.0 * e)
		sp.rotation = wd
		sp.scale = Vector2(sc * (1.6 + 2.2 * (1.0 - y)), sc)
		sp.modulate = Color(0.62, 1.0, 0.74, a * (0.6 + 0.4 * h))
		q += 1

func pose_strips() -> void:
	# every strip of her gauze, by what time it is: as it lies on her (the wind at it more and more), or in the air
	for st in strands:
		var poly: Polygon2D = st["poly"]
		var ghosts: Array = st["ghosts"]
		var tau: float = TT - float(st["tear"])
		if tau >= FLY_DUR:
			# (it has been blown off her: nothing of it is left)
			st["fade"] = 0.0
			if poly.visible:
				poly.visible = false
				for gp0 in ghosts: gp0.visible = false
			puff(st, -1.0)
			continue
		if not poly.visible: poly.visible = true
		if tau <= 0.0:
			poly.polygon = strip(pose_strand(st), st)
			st["fade"] = 1.0
			if ghosts[0].visible:
				for gp1 in ghosts: gp1.visible = false
			puff(st, -1.0)
			continue
		var fl: PackedVector2Array = fly(st, torn_of(st), tau)
		var pr: float = tau / FLY_DUR
		var thin: float = 1.0 - 0.15 * smoothstep(0.0, 0.5, pr)
		var al: float = (1.0 - 0.40 * smoothstep(0.03, 0.40, pr)) * (1.0 - smoothstep(0.62, 1.0, pr))
		poly.polygon = strip(fl, st, thin)
		st["fade"] = al
		var gf: Array = st["gfade"]
		for gi in range(GHOSTS):
			# (its smear - the same strip, wider and fainter - only where it cannot be blurred)
			var gp: Polygon2D = ghosts[gi]
			gp.visible = veil_state != 1
			if not gp.visible: continue
			gp.polygon = strip(fl, st, thin * GWIDE[gi])
			gf[gi] = al * GALPHA[gi] * smoothstep(0.0, 0.06, tau)
		puff(st, tau)

func pose_bands(shade: Color) -> void:
	# the bands wound on her body: seen only as the wind gets under them, lifts them and carries them off
	for bs in bstrands:
		var tau: float = TT - float(bs["tear"])
		if tau <= -BAND_LIFT or tau >= FLY_DUR:
			if bs["shown"]:
				bs["shown"] = false
				for bp0 in bs["polys"]: bp0.visible = false
			puff(bs, -1.0)
			continue
		bs["shown"] = true
		var polys: Array = bs["polys"]
		var wk: float = bs["wk"]
		if tau <= 0.0:
			var ub: float = 1.0 + tau / BAND_LIFT
			var bp1: Polygon2D = polys[0]
			bp1.visible = true
			bp1.polygon = strip(lift_band(bs, ub * ub), bs, wk)
			bp1.color = Color(shade.r, shade.g, shade.b, smoothstep(0.0, 0.6, ub))
			for gi in range(1, GHOSTS + 1): polys[gi].visible = false
			puff(bs, -1.0)
			continue
		var fl: PackedVector2Array = fly(bs, bs["torn"], tau)
		var pr: float = tau / FLY_DUR
		var thin: float = (1.0 - 0.15 * smoothstep(0.0, 0.5, pr)) * wk
		var al: float = (1.0 - 0.40 * smoothstep(0.03, 0.40, pr)) * (1.0 - smoothstep(0.62, 1.0, pr))
		for gi in range(GHOSTS + 1):
			var bp2: Polygon2D = polys[gi]
			bp2.visible = gi == 0 or veil_state != 1
			if not bp2.visible: continue
			bp2.polygon = strip(fl, bs, thin if gi == 0 else thin * GWIDE[gi - 1])
			bp2.color = Color(shade.r, shade.g, shade.b, al * (1.0 if gi == 0 else GALPHA[gi - 1] * smoothstep(0.0, 0.06, tau)))
		puff(bs, tau)

const GHOSTS := 2                # the smear of a strip in the air, where it cannot be blurred: the same strip again, wider and fainter
const GWIDE := [1.7, 2.6]
const GALPHA := [0.30, 0.15]

const THIN := 2                  # every THIN-th point of a strand's middle line is kept (they lie 8 pixels apart)

func make_strand(d, fam_index: int) -> Dictionary:
	var n0: int = d["pts"].size()
	var p := PackedVector2Array()
	var arc := PackedFloat32Array(); var left := PackedFloat32Array(); var right := PackedFloat32Array()
	for i in range(n0):
		if i % THIN != 0 and i != n0 - 1 and float(d["arc"][i]) > 8.0: continue
		p.append(Vector2(d["pts"][i][0], d["pts"][i][1]))
		arc.append(float(d["arc"][i])); left.append(float(d["left"][i])); right.append(float(d["right"][i]))
	var n: int = p.size()
	var st := {"d": d, "n": n, "fam": fam_index, "rest": p, "arc": arc, "left": left, "right": right, "fan": d["kind"] == "fan"}
	var poly = Polygon2D.new()
	poly.texture = tex("../tex3/" + d["tex"])          # (the strips without the turns of her jaw and neck that had been counted with them)
	var uv := PackedVector2Array(); uv.resize(n * 2)
	var verts = strip(p, st)
	for i in range(n * 2): uv[i] = verts[i] - Vector2(d["ox"], d["oy"])
	poly.polygon = verts; poly.uv = uv
	var tris := []
	for i in range(n - 1):
		tris.append(PackedInt32Array([2 * i, 2 * i + 2, 2 * i + 3]))
		tris.append(PackedInt32Array([2 * i, 2 * i + 3, 2 * i + 1]))
	poly.polygons = tris
	st["poly"] = poly
	var nr := PackedVector2Array()
	for i in range(n): nr.append(normal_at(p, i))
	st["nrm"] = nr
	# where it leaves her head
	var dep = n - 1
	for i in range(n):
		if arc[i] > 0.0 and (1.0 - smoothstep(HR * 0.80, HR * 1.30, (p[i] - HC).length())) < 0.5:
			dep = i
			break
	st["dep"] = dep
	var nm: String = d["name"]
	st["side"] = (1.0 if nm.begins_with("L") else -1.0) if d["kind"] == "fan" else (1.0 if p[n - 1].x < HC.x else -1.0)
	st["sway_ph"] = -1e9
	return st

func sway(st: Dictionary, ph: float) -> PackedVector2Array:
	if st["sway_ph"] == ph: return st["sway"]             # (her hair sways on a phase that mostly stands still while she is played)
	var n: int = st["n"]
	var rest: PackedVector2Array = st["rest"]
	var nrm: PackedVector2Array = st["nrm"]
	var arc: PackedFloat32Array = st["arc"]
	var f: int = st["fam"]
	var fan: bool = st["fan"]
	var a: float = 20.0 if fan else 15.0
	var k1: float = 2.2 if fan else 1.5
	var k2: float = 4.6 if fan else 3.3
	var ph1: float = TAU * hash1(f * 7 + 1) * (1.0 if fan else 0.35) + (0.0 if fan else 0.6)
	var ph2: float = TAU * hash1(f * 7 + 2)
	var out := PackedVector2Array(); out.resize(n)
	for i in range(n):
		var u: float = max(arc[i], 0.0) / 600.0
		var amp: float = a * pow(min(u, 1.7), 1.5)
		var w: float = sin(ph - k1 * u + ph1) + 0.45 * sin(2.0 * ph - k2 * u + ph2)
		out[i] = rest[i] + nrm[i] * (amp * w)
	st["sway"] = out; st["sway_ph"] = ph
	return out

func pose_strand(st: Dictionary) -> PackedVector2Array:
	var n: int = st["n"]
	var rest: PackedVector2Array = st["rest"]
	var arc: PackedFloat32Array = st["arc"]
	var p: PackedVector2Array = sway(st, P["ph"])
	var fan: bool = st["fan"]
	var side: float = st["side"]
	var zk: float = 0.35 if fan else 1.0
	var dep: int = st["dep"]
	var pd: Vector2 = rest[dep]
	var dd: Vector2 = head_rigid(pd, head_z(pd) * zk) - pd
	var arc0: float = arc[dep]
	var span: float = max(arc[n - 1] - arc0, 1.0)
	var updraft: float = float(X["updraft"]) * (0.5 if fan else 1.0)
	var part: float = float(X["part"]) * side
	var carry_far: float = 0.7 if fan else 0.45
	var out := PackedVector2Array(); out.resize(n)
	for i in range(n):
		var r: Vector2 = rest[i]
		var w: float = head_w(r)
		var pi: Vector2 = p[i]
		var s: float = max(arc[i] - arc0, 0.0)
		var carry: float = lerp(1.0, carry_far, smoothstep(0.0, 420.0, s))
		var o: Vector2 = pi + dd * (carry * (1.0 - w)) + d_breath(r)
		if w > 0.0: o += (head_rigid(pi, head_z(r) * zk) - pi) * w
		var v: float = s / span
		o.y -= updraft * pow(v, 1.3)
		if not fan:
			# her front hair parted, like a curtain, over her throat and chest
			o.x -= part * smoothstep(0.05, 0.45, v) * (1.0 - 0.40 * smoothstep(0.5, 1.0, v))
		out[i] = o
	# bent, from where it leaves her head, more and more to its end
	var bend: float = deg_to_rad(X["fan"] if fan else X["flare"]) * side
	var res := PackedVector2Array(); res.resize(n)
	for i in range(dep + 1): res[i] = out[i]
	var lam: float = lift_of(st, TT) if TT > T_GO else 0.0
	if lam > 0.0:
		wind_turn(st, out, res, lam, bend)
	else:
		for i in range(dep, n - 1):
			var u: float = (arc[i] - arc0) / span
			res[i + 1] = res[i] + (out[i + 1] - out[i]).rotated(bend * pow(clamp(u, 0.0, 1.0), 0.75))
	var blast: float = X["blast"]
	if blast != 0.0:
		# Her scream comes out of her mouth, behind the gauze that hangs over her face: each strip is hit where it
		# passes nearest her mouth and thrown outward from there, a wave running down it to its free end. Above
		# her mouth it is held by her head; strips far from her mouth get less.
		var im: int = 0
		var best: float = 1e18
		for i in range(n):
			if arc[i] < 0.0: continue
			var dq: float = res[i].distance_squared_to(M2)
			if dq < best:
				best = dq; im = i
		var kk: float = 0.22 if fan else (0.30 + 0.70 * exp(-best / 22500.0))
		var s0: float = arc[im]
		var was: PackedVector2Array = res.duplicate()
		var aside := Vector2(-side, 0.0)
		var wave: float = 5.0 * TT
		for i in range(n):
			var sg: float = arc[i] - s0
			var live: float = smoothstep(-60.0, 70.0, sg)
			if live <= 0.0: continue
			var past: float = max(sg, 0.0)
			var dir: Vector2 = was[i] - M2
			var dl: float = dir.length()
			dir = (dir / dl) if dl > 1.0 else aside
			res[i] = was[i] + dir * (blast * kk * live * exp(-past / 460.0)) + normal_at(was, i) * (0.30 * blast * kk * live * sin(TAU * (sg / 190.0 - wave)) * exp(-past / 420.0))
	return res

func fnear(u: float) -> float:
	# how big the thrown fire is, along its way: smaller as it goes back and up, bigger as it falls back to us,
	# and into him
	if u < APEX: return lerp(1.0, 0.46, smoothstep(0.0, APEX, u))
	return lerp(0.46, 1.12, smoothstep(APEX, 0.86, u)) * (1.0 - 0.50 * smoothstep(0.93, 1.0, u))

func tip_at(t: float, i: int) -> Vector2:
	X = x_at(t); pose()
	return figure.transform * (grip[i].transform * (blade[i].transform * Vector2(0, -150)))

func bez(a: Vector2, b: Vector2, c: Vector2, u: float) -> Vector2:
	return a.lerp(b, u).lerp(b.lerp(c, u), u)

func pose():
	frame_numbers()
	# all of her: down or up, drawn out or pressed down about her roots
	var sy: float = X["sy"]
	var sc = Vector2(1.0 + (1.0 - sy) * 0.45, sy)
	# and nearer to us: bigger about her chest
	var zm: float = X["zoom"]
	figure.scale = sc * zm
	figure.position = OFF + ZC + (ANCHOR - Vector2(ANCHOR.x * sc.x, ANCHOR.y * sc.y) - ZC) * zm + Vector2(0, X["sink"])
	if figure_t != null: figure_t.scale = figure.scale; figure_t.position = figure.position
	# (her chest and neck do not go with her head: her jaw and skull are their own pieces now)
	for tm in [torso_mat, neck_mat]:
		tm.set_shader_parameter("breath", X["breath"])
		tm.set_shader_parameter("tilt", 0.0); tm.set_shader_parameter("nod", 0.0); tm.set_shader_parameter("rise", 0.0); tm.set_shader_parameter("hscale", 1.0)
	M2 = head_rigid(MOUTH, head_z(MOUTH)) + d_breath(HC)
	torso_mat.set_shader_parameter("sleeve_l", sleeve_ang(0)); torso_mat.set_shader_parameter("sleeve_r", sleeve_ang(1))
	neck_mat.set_shader_parameter("sleeve_l", 0.0); neck_mat.set_shader_parameter("sleeve_r", 0.0)
	dress_mat.set_shader_parameter("breath", clamp(X["breath"], -1.0, 1.6))
	dress_mat.set_shader_parameter("phase", P["ph"])
	pose_veils()
	pose_strips()
	# what is below her elbows, and her blades
	for i in range(2):
		var sgn = 1.0 if i == 0 else -1.0
		var e: Vector2 = low[i].get_meta("elbow")
		var e2 = where(e)
		var rot = sleeve_ang(i) * sleeve_k(e, i) + deg_to_rad(X["fore"]) * sgn
		for nd in [low[i], grip[i], fistg[i]]:
			nd.position = e2; nd.rotation = rot
		var b: Node2D = blade[i]
		b.rotation = -deg_to_rad(X["knife"]) * sgn                      # (her blade lies with its handle: one straight thing)
		b.scale = Vector2(X["blade_w"], max(X["blade_l"], 0.01))
		b.visible = X["blade_l"] > 0.05
		b.modulate = Color(1, 1, 1, X["body"])
		fire_mats[i].set_shader_parameter("phase", TAU * 1.6 * TT + i * 1.7)
		fire_mats[i].set_shader_parameter("amount", X["amount"])
		if fire_mats_t[i] != null:
			fire_mats_t[i].set_shader_parameter("phase", TAU * 1.6 * TT + i * 1.7)
			fire_mats_t[i].set_shader_parameter("amount", X["amount"])
	# her horns: with her head (their roots on its front, their tips behind it)
	var hl = d_breath(HC)
	for i in range(2):
		var h: Node2D = horns[i]
		var base: Vector2 = h.get_meta("base"); var tip: Vector2 = h.get_meta("tip")
		# (their roots are behind the middle of her head: as her face comes up they go down. Seen from the front a
		#  horn thrown back would all but vanish; it keeps most of its length and swings out instead - it reads.)
		var b2 = head_rigid(base, -30.0) + hl
		var t2 = head_rigid(tip, -30.0) + hl
		var ax = tip - base; var ax2 = t2 - b2
		var sx = lerp(1.0, ax2.length() / ax.length(), 0.45)
		var phi2 = ax.angle() + deg_to_rad(X["nod"]) + deg_to_rad(X["horn"]) * (-1.0 if i == 0 else 1.0)
		h.transform = Transform2D(phi2, b2) * Transform2D(0.0, Vector2(sx, 1.0), 0.0, Vector2.ZERO) * Transform2D(-ax.angle(), Vector2.ZERO) * Transform2D(0.0, -base)
	# her jaw and her skull: stiff, with her head (her jaw keeps its own outline - it is not drawn out into her neck)
	var jt = Vector2(606, 548); var jb = Vector2(606, 648)
	var jt2 = head_rigid(jt, head_z(jt)) + hl; var jb2 = head_rigid(jb, head_z(jb)) + hl
	var hx = Vector2(X["head_s"], 0).rotated(deg_to_rad(X["nod"]))
	jawn.transform = Transform2D(hx, (jb2 - jt2) / 100.0, jt2) * Transform2D(0.0, -jt)
	var kt = Vector2(606, 340)
	var kt2 = head_rigid(kt, head_z(kt)) + hl
	skulln.transform = Transform2D(hx, (jt2 - kt2) / 208.0, kt2) * Transform2D(0.0, -kt)
	# the slits of her eyes: on her face
	var top = Vector2(615, 486); var bot = Vector2(615, 586)
	var top2 = head_rigid(top, head_z(top)) + hl; var bot2 = head_rigid(bot, head_z(bot)) + hl
	slits.transform = Transform2D(Vector2(1, 0).rotated(deg_to_rad(X["nod"])), (bot2 - top2) / 100.0, top2) * Transform2D(0.0, -top)
	# the fire of her eye: its root on her eye; longer, and more upright as her head goes back
	var root: Vector2 = eye.get_meta("root"); var etip: Vector2 = eye.get_meta("tip")
	var root2 = head_rigid(root, head_z(root)) + hl
	var phi = (etip - root).angle()
	eye.transform = Transform2D(deg_to_rad(X["eye_rot"] + X["nod"]), root2) * Transform2D(phi, Vector2.ZERO) * Transform2D(0.0, Vector2(X["eye_len"], X["eye_w"]), 0.0, Vector2.ZERO) * Transform2D(-phi, Vector2.ZERO)
	eye.modulate = Color(1, 1, 1, X.get("eyea", 1.0)); slits.modulate = Color(1, 1, 1, X["body"])
	for g in glows:
		g.modulate = Color(1, 1, 1, clamp(0.40 * X["glow"], 0.0, 1.0))
	# ---- her howl: her mouth lit, the sound going up from it, a light behind her
	var m2 = head_rigid(MOUTH, head_z(MOUTH)) + hl
	var hw: float = X["howl"]
	var hw0 = hw
	hw = max(hw, X["ring"])
	mouth_glow.visible = hw > 0.01
	mouth_glow.position = m2
	mouth_glow.scale = Vector2(1.1, 1.6) * (0.6 + 0.5 * min(hw * 3.0, 1.0))
	mouth_glow.modulate = Color(0.55, 1.0, 0.50, 0.55 * min(hw * 6.0, 1.0) * X.get("eyea", 1.0))
	for j in range(rings.size()):
		var r: ColorRect = rings[j]
		var u = hw0 - 0.30 * j                      # each a while after the last
		r.visible = u > 0.08
		if not r.visible: continue
		var uu = min(u, 1.0)
		var rad = 90.0 + 620.0 * (1.0 - pow(1.0 - uu, 1.7))
		r.size = Vector2(rad * 2.2, rad * 2.2)
		r.position = m2 - r.size * 0.5
		var rm: ShaderMaterial = r.material
		rm.set_shader_parameter("alpha", 0.9 * pow(1.0 - 0.72 * uu, 1.3))
		rm.set_shader_parameter("width", 0.030 + 0.03 * (1.0 - uu))
		rm.set_shader_parameter("spread", 0.55 + 0.25 * uu)
	for j in range(rings2.size()):
		var r2: ColorRect = rings2[j]
		var since = TT - T_GO - 0.05 - 0.40 * j
		var u2 = fposmod(since / 1.20, 1.0) if since > 0.0 else -1.0
		r2.visible = u2 > 0.05
		if not r2.visible: continue
		var uu2 = min(u2, 1.0)
		var rad2 = 110.0 + 560.0 * (1.0 - pow(1.0 - uu2, 1.6))
		r2.size = Vector2(rad2 * 2.2, rad2 * 2.2)
		r2.position = m2 - r2.size * 0.5
		var rm2: ShaderMaterial = r2.material
		rm2.set_shader_parameter("alpha", 0.26 * pow(1.0 - 0.80 * uu2, 1.3) * X["ringa"])
		rm2.set_shader_parameter("width", 0.012 + 0.016 * (1.0 - uu2))
	cone.visible = X["howl"] > 0.01
	cone.size = Vector2(760, 900) * (0.5 + 0.5 * min(hw * 2.0, 1.0))
	cone.position = m2 - Vector2(cone.size.x * 0.5, cone.size.y)
	cone.material.set_shader_parameter("alpha", 0.30 * min(hw * 3.0, 1.0))
	var shade = Color(1, 1, 1).lerp(Color(0.26, 0.36, 0.33), X["shade"])
	for dn in dims:
		if dn is Polygon2D: dn.color = shade
		else: dn.self_modulate = Color(shade.r, shade.g, shade.b, X["body"])
	for st in strands:
		st["poly"].color.a = st["fade"]
		for gi in range(GHOSTS):
			st["ghosts"][gi].color = Color(shade.r, shade.g, shade.b, st["gfade"][gi])
	pose_bands(shade)
	backlight.position = where(CHEST) + Vector2(0, -170)
	backlight.modulate = Color(0.45, 1.0, 0.55, X["back"])
	veil.color = Color(0.010, 0.045, 0.028, clamp(X["veil"] * P["dark"] * FADE, 0.0, 0.97))
	# ---- the fire thrown off her blades: the same shape, on its way down into the one who plays her
	var sh: float = X["shed"]
	for i in range(2):
		var b: Node2D = blade[i]
		var src = figure.transform * (grip[i].transform * b.position)
		var dst = OFF + WHO + Vector2(-22.0 if i == 0 else 22.0, -60.0)
		var ctl = Vector2(lerp(src.x, dst.x, 0.25) + (-150.0 if i == 0 else 150.0), lerp(src.y, dst.y, 0.55))
		for g in range(3):
			var s: Node2D = sheds[i * 3 + g]
			var u = sh - 0.06 * g
			s.visible = sh >= 0.0 and u > 0.0 and u < 0.97
			if not s.visible: continue
			var at = bez(src, ctl, dst, u)
			var v = (bez(src, ctl, dst, min(u + 0.02, 1.0)) - bez(src, ctl, dst, max(u - 0.02, 0.0))).normalized()
			var along = atan2(-v.x, v.y)                           # its root first, its tip behind
			s.position = at
			s.rotation = lerp_angle(b.global_rotation, along, smoothstep(0.0, 0.35, u))
			var into = 1.0 - smoothstep(0.80, 0.97, u)
			s.scale = Vector2(1.0 - 0.25 * sin(PI * u), 1.0 + 0.7 * sin(PI * min(u * 1.2, 1.0))) * lerp(0.35, 1.15, into)
			s.modulate = Color(1, 1, 1, [1.0, 0.34, 0.14][g] * into)
	var chest_at = figure.transform * where(CHEST)
	chest_flash.visible = X["flashc"] > 0.01
	chest_flash.position = chest_at
	chest_flash.scale = Vector2.ONE * (2.2 + 3.6 * (1.0 - X["flashc"]))          # (a knock of light, small and bright, opening as it goes)
	chest_flash.modulate = Color(0.62, 1.0, 0.62, 0.85 * X["flashc"])
	var fl: float = X["fly"]
	for i in range(2):
		var hd2: Node2D = heads[i]
		var gl2: Sprite2D = fglow[i]
		gl2.visible = false
		trails[i][0].visible = false; trails[i][1].visible = false
		hd2.visible = fl >= 0.0 and fl < 1.0 and fpath.size() == 2
		if fl < 0.0 or fpath.size() < 2:
			for tn0 in tails[i]: tn0.visible = false
			continue
		var pts: PackedVector2Array = fpath[i]
		# its tail: tongues of the same fire, each where its head was a moment before - close behind its head they
		# lie one over the next (one ragged flame, wide at the head, drawn out to nothing); further back a few
		# small ones are left hanging in the air where it went, going out. It is long while it is fast, and
		# gathers up as it slows at the top of its way.
		for j in range(TAILN):
			var tn: Node2D = tails[i][j]
			var dense = j < 14
			var fj = (float(j + 1) / 14.0) if dense else (float(j - 13) / float(TAILN - 14))
			var ft = fl - ((0.085 * fj) if dense else (0.085 + 0.24 * fj))
			tn.visible = ft > 0.0 and ft < 1.0
			if not tn.visible: continue
			var uj = fmap(ft)
			var qf = uj * 100.0
			var qi = int(floor(min(qf, 99.0)))
			var pj = pts[qi].lerp(pts[qi + 1], qf - qi)
			var tv = (pts[min(qi + 2, 100)] - pts[max(qi - 1, 0)]).normalized()
			var jit = hash1(i * 100 + j * 7 + 3) - 0.5
			tn.position = pj + Vector2(-tv.y, tv.x) * (jit * (22.0 * fj if dense else 30.0))
			tn.rotation = atan2(-tv.x, tv.y) + jit * (0.5 * fj if dense else 0.9)
			var sj = fnear(uj) * (lerp(1.15, 0.34, pow(fj, 0.75)) if dense else lerp(0.34, 0.18, fj))
			tn.scale = Vector2(sj * 0.9, sj * 1.25)
			var aj = (pow(1.0 - fj, 0.8) * 0.95 + 0.05) if dense else lerp(0.40, 0.04, fj)
			tn.modulate = Color(lerp(1.0, 0.50, fj if dense else 1.0), 1.0, lerp(1.0, 0.55, fj if dense else 1.0), aj * smoothstep(0.0, 0.03, ft))
			var want = trail_back if uj < APEX + 0.06 else trail_front
			if tn.get_parent() != want:
				tn.get_parent().remove_child(tn); want.add_child(tn); want.move_child(tn, 0)
		if not hd2.visible: continue
		var uh = fmap(fl)
		var qh = uh * 100.0
		var ih = int(floor(min(qh, 99.0)))
		hd2.position = pts[ih].lerp(pts[ih + 1], qh - ih)
		var vv = (pts[min(ih + 2, 100)] - pts[max(ih - 1, 0)]).normalized()
		hd2.rotation = atan2(-vv.x, vv.y)
		# (it is small while it is far behind her, and comes up big as it falls back towards us)
		var near = fnear(uh) * smoothstep(-0.02, 0.05, fl)
		hd2.scale = Vector2(near * 1.15, near * 1.4)
		var wanth = trail_back if uh < APEX + 0.06 else trail_front
		if hd2.get_parent() != wanth:
			hd2.get_parent().remove_child(hd2); wanth.add_child(hd2)
		# (the light about it: where it is, but not blurred with it)
		var wantg = fglow_b if wanth == trail_back else fglow_f
		if gl2.get_parent() != wantg:
			gl2.get_parent().remove_child(gl2); wantg.add_child(gl2)
		gl2.visible = true
		gl2.position = hd2.position; gl2.rotation = hd2.rotation; gl2.scale = hd2.scale * 2.2
	pose_fire_veils(fl)
	pose_wave()
	if stage_t != null: sync_top()
	var wh: float = X["who"]
	who_glow.visible = wh > 0.01
	who_glow.modulate = Color(0.40, 1.0, 0.50, 0.75 * wh)

func build(p_dir: String, p_cache: Dictionary, p_back: Node, p_front: Node, p_lo: Vector2, p_hi: Vector2, p_org: Vector2, p_k: float, p_who: Vector2) -> bool:
	DIR = p_dir; CACHE = p_cache
	if CACHE.has("rig2"): rig = CACHE["rig2"]
	else:
		rig = JSON.parse_string(FileAccess.get_file_as_string(DIR + "/rig2.json"))
		CACHE["rig2"] = rig
	if rig == null: return false
	L = rig["layers"]
	var sc = P["sc"]
	KK = p_k / sc
	BASE = p_org - OFF * p_k
	WHOX = (p_who - (p_org + WHO * p_k)) / p_k
	veil = ColorRect.new(); veil.mouse_filter = Control.MOUSE_FILTER_IGNORE
	veil.position = p_lo - Vector2(600, 600); veil.size = (p_hi - p_lo) + Vector2(1200, 1200); veil.color = Color(0, 0, 0, 0)
	p_back.add_child(veil)
	FRONTN = p_front; VLO = p_lo; VHI = p_hi
	# (the first wave of her scream: a screen and a half a second)
	WAVEC = 1.5 * (p_hi.y - p_lo.y) / (p_k * 1.15)
	stage_b = Node2D.new(); stage_b.scale = Vector2(p_k, p_k); stage_b.position = BASE; p_back.add_child(stage_b)
	stage_f = Node2D.new(); stage_f.scale = Vector2(p_k, p_k); stage_f.position = BASE; p_front.add_child(stage_f)
	addm = CanvasItemMaterial.new(); addm.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	var grad = Gradient.new(); grad.offsets = PackedFloat32Array([0, 0.35, 1]); grad.colors = PackedColorArray([Color(1, 1, 1, 1), Color(1, 1, 1, 0.45), Color(1, 1, 1, 0)])
	var gt = GradientTexture2D.new(); gt.gradient = grad; gt.width = 128; gt.height = 128; gt.fill = GradientTexture2D.FILL_RADIAL; gt.fill_from = Vector2(0.5, 0.5); gt.fill_to = Vector2(1.0, 0.5)
	trail_back = Node2D.new(); stage_b.add_child(trail_back)
	fglow_b = Node2D.new(); stage_b.add_child(fglow_b)
	figure = Node2D.new(); stage_b.add_child(figure)
	gtex = gt
	backlight = Sprite2D.new(); backlight.texture = gt; backlight.material = addm; backlight.scale = Vector2(11, 11); figure.add_child(backlight)
	back = Node2D.new(); figure.add_child(back)
	var dress = sprite(L["dress"]); dress.texture = tex("../tex/dress.png")
	dress_mat = shader_mat("dress.gdshader"); dress.material = dress_mat; figure.add_child(dress); dims.append(dress)
	dress_mat.set_shader_parameter("origin", Vector2(L["dress"]["ox"], L["dress"]["oy"])); dress_mat.set_shader_parameter("extent", Vector2(L["dress"]["w"], L["dress"]["h"]))
	blade_layer = Node2D.new(); figure.add_child(blade_layer)
	# what is below her elbows (under her sleeves)
	for key in ["lowL", "lowR"]:
		var e = Vector2(L[key]["elbow"][0], L[key]["elbow"][1])
		var nd = Node2D.new(); nd.set_meta("elbow", e); figure.add_child(nd); low.append(nd)
		var s = sprite(L[key + "_c"]); s.position -= e; nd.add_child(s); dims.append(s)
	# her neck (it goes with her chest), her chest and sleeves, then her skull and her jaw (they go with her head)
	var neck = sprite(L["under_neck"]); neck_mat = shader_mat("torso.gdshader"); neck.material = neck_mat; figure.add_child(neck); dims.append(neck)
	neck_mat.set_shader_parameter("origin", Vector2(L["under_neck"]["ox"], L["under_neck"]["oy"])); neck_mat.set_shader_parameter("extent", Vector2(L["under_neck"]["w"], L["under_neck"]["h"]))
	var torso = sprite(L["torso_c"]); torso_mat = shader_mat("torso.gdshader"); torso.material = torso_mat; figure.add_child(torso); dims.append(torso)
	torso_mat.set_shader_parameter("origin", Vector2(L["torso_c"]["ox"], L["torso_c"]["oy"])); torso_mat.set_shader_parameter("extent", Vector2(L["torso_c"]["w"], L["torso_c"]["h"]))
	skulln = Node2D.new(); figure.add_child(skulln); var sks = sprite(L["skull"]); skulln.add_child(sks); dims.append(sks)
	jawn = Node2D.new(); figure.add_child(jawn); var jws = sprite(L["under_jaw"]); jawn.add_child(jws); dims.append(jws)
	for key in ["hornL", "hornR"]:
		var nd = Node2D.new(); figure.add_child(nd); horns.append(nd)
		nd.set_meta("base", Vector2(L[key]["base"][0], L[key]["base"][1])); nd.set_meta("tip", Vector2(L[key]["tip"][0], L[key]["tip"][1]))
		var hs = sprite(L[key]); nd.add_child(hs); dims.append(hs)
		var hg = light(L["glow_" + key], Vector2.ZERO); nd.add_child(hg)
	mouth_glow = Sprite2D.new(); mouth_glow.texture = gt; mouth_glow.material = addm; figure.add_child(mouth_glow)
	# her blades of fire, and the light of her fists
	var k := 0
	for key in ["fireL", "fireR"]:
		var lowk = "lowL" if k == 0 else "lowR"
		var e = Vector2(L[lowk]["elbow"][0], L[lowk]["elbow"][1])
		var foot = Vector2(L[key]["foot"][0], L[key]["foot"][1])
		var gr = Node2D.new(); blade_layer.add_child(gr); grip.append(gr)
		var fg = Node2D.new(); figure.add_child(fg); fistg.append(fg)
		fg.add_child(light(L["glow_" + lowk], e))
		var b = Node2D.new(); b.position = foot - e; gr.add_child(b); blade.append(b)
		var f = sprite(L[key]); f.position -= foot
		var m = shader_mat("fire.gdshader")
		m.set_shader_parameter("foot", Vector2((foot.x - L[key]["ox"]) / L[key]["w"], (foot.y - L[key]["oy"]) / L[key]["h"]))
		m.set_shader_parameter("seed", 0.0 if k == 0 else 2.4)
		f.material = m; fire_mats.append(m); b.add_child(f)
		b.add_child(light(L["glowL" if k == 0 else "glowR"], foot))
		b.set_meta("foot", foot); b.set_meta("layer", key)
		k += 1
	frontn = Node2D.new(); figure.add_child(frontn)
	puffn = Node2D.new(); figure.add_child(puffn)
	var fams := {}
	for d in rig["strands"]:
		if not fams.has(d["family"]): fams[d["family"]] = fams.size()
		var st = make_strand(d, fams[d["family"]])
		st["idx"] = strands.size(); st["fade"] = 1.0
		strands.append(st)
		var par = (back if st["fan"] else frontn)
		st["ghosts"] = []; st["gfade"] = [0.0, 0.0, 0.0, 0.0]
		for gi in range(GHOSTS):
			var gp = Polygon2D.new(); gp.texture = st["poly"].texture; gp.polygon = st["poly"].polygon; gp.uv = st["poly"].uv; gp.polygons = st["poly"].polygons
			gp.visible = false; par.add_child(gp); st["ghosts"].append(gp)
		par.add_child(st["poly"]); dims.append(st["poly"])
	# the order her gauze is drawn off her in: her side hair from the top down (one side, the other, ...), then
	# what hangs in front from the outside in - what lies over her face the last
	var fl2 := []; var fr2 := []
	for st in strands:
		var rp: PackedVector2Array = st["rest"]
		if st["fan"]:
			fl2.append([rp[st["n"] - 1].y, st])
		else:
			var nearm = 1e18
			for q in rp: nearm = min(nearm, q.distance_to(MOUTH))
			fr2.append([-nearm, st])
	fl2.sort_custom(func(a, b): return a[0] < b[0]); fr2.sort_custom(func(a, b): return a[0] < b[0])
	for q in range(fl2.size()): fl2[q][1]["order"] = 0.50 * float(q) / float(fl2.size())
	for q in range(fr2.size()): fr2[q][1]["order"] = 0.42 + 0.58 * float(q) / float(max(fr2.size() - 1, 1))
	for st in strands:
		var sn2: int = st["n"]
		st["arc0"] = st["arc"][st["dep"]]
		st["span"] = max(st["arc"][sn2 - 1] - st["arc"][st["dep"]], 1.0)
		wind_of(st, st["rest"], st["dep"], -1.0 if st["side"] > 0.0 else 1.0, int(st["idx"]))
	# (some of her strips are only a shred - the picture of them begins far from where they are held. A loose
	#  shred is the first thing the wind takes: these go before the first whole strip, one after another)
	var shreds := 0
	for st in strands:
		var dd = st["d"]
		var rp2: PackedVector2Array = st["rest"]
		if Rect2(Vector2(dd["ox"], dd["oy"]), st["poly"].texture.get_size()).grow(120.0).has_point(rp2[0]): continue
		st["tear"] = T_GO + 0.20 + 0.045 * shreds
		shreds += 1
	# the bands wound on her body go the same way: strips of the same gauze (her own long strips, laid along her
	# arms, across her chest, down her dress) that are only seen as they are drawn off her, while she fades
	var lay = [[Vector2(470, 655), 38.0, 0.50], [Vector2(738, 655), -38.0, 0.50], [Vector2(545, 640), -22.0, 0.55], [Vector2(665, 640), 22.0, 0.55],
		[Vector2(430, 760), 50.0, 0.45], [Vector2(780, 760), -50.0, 0.45], [Vector2(560, 800), 12.0, 0.60], [Vector2(650, 800), -12.0, 0.60],
		[Vector2(520, 960), 18.0, 0.62], [Vector2(690, 960), -18.0, 0.62], [Vector2(585, 1010), 6.0, 0.66], [Vector2(628, 1010), -6.0, 0.66]]
	var longs := []
	for st in strands:
		if not st["fan"] and st["arc"][st["n"] - 1] > 700.0: longs.append(st)
	bodyr = Node2D.new(); figure.add_child(bodyr); figure.move_child(bodyr, frontn.get_index())
	for q in range(lay.size() if P["bodyr"] > 0.5 else 0):
		var src = longs[q % longs.size()]
		var sn: int = src["n"]
		var i0 = 0
		while src["arc"][i0] < 60.0: i0 += 1                                # (from where it hangs clear of her head)
		var rp: PackedVector2Array = src["rest"]
		var down = (rp[sn - 1] - rp[i0]).angle()
		var m = Transform2D(deg_to_rad(90.0 + lay[q][1]) - down, lay[q][0]) * Transform2D(0.0, Vector2(lay[q][2], lay[q][2]), 0.0, Vector2.ZERO) * Transform2D(0.0, -rp[i0])
		var bs := {"n": sn, "idx": 100 + q, "wk": lay[q][2], "left": src["left"], "right": src["right"], "shown": false, "dep": i0}
		var bp := PackedVector2Array()
		for q2 in range(sn): bp.append(m * rp[q2])
		bs["rest"] = bp
		var wm0 := PackedFloat32Array(); wm0.resize(sn); wm0.fill(lay[q][2]); bs["wm0"] = wm0
		bs["order"] = 0.40 + 0.60 * float(q) / float(lay.size() - 1)
		var ox2 = -1.0 if lay[q][0].x < 604.0 else 1.0
		# (how far along it each point is, as it lies on her - it is her own long strip, made smaller)
		var barc := PackedFloat32Array(); barc.resize(sn)
		for q2 in range(sn): barc[q2] = (float(src["arc"][q2]) - float(src["arc"][i0])) * float(lay[q][2])
		bs["arc"] = barc; bs["arc0"] = 0.0; bs["span"] = max(barc[sn - 1], 1.0)
		wind_of(bs, bp, i0, ox2, 100 + q)
		bs["polys"] = []
		for gi in range(GHOSTS + 1):
			var gp = Polygon2D.new(); gp.texture = src["poly"].texture; gp.polygon = src["poly"].polygon; gp.uv = src["poly"].uv; gp.polygons = src["poly"].polygons
			gp.visible = false; bodyr.add_child(gp); bs["polys"].append(gp)
		# (as it tears off: the wind has brought all of it round)
		var keeptt: float = TT
		TT = bs["tear"]
		bs["torn"] = lift_band(bs, 1.0)
		TT = keeptt
		bstrands.append(bs)
	slits = Node2D.new(); figure.add_child(slits)
	slits.add_child(sprite(L["slits"])); slits.add_child(light(L["glow_slits"], Vector2.ZERO))
	eye = Node2D.new(); figure.add_child(eye)
	var er = Vector2(L["eyefire"]["root"][0], L["eyefire"]["root"][1])
	eye.set_meta("root", er); eye.set_meta("tip", Vector2(L["eyefire"]["tip"][0], L["eyefire"]["tip"][1]))
	var es = sprite(L["eyefire"]); es.position -= er; eye.add_child(es)
	eye.add_child(light(L["glow_eye"], er))
	# the sound of her howl
	for j in range(3):
		var r = ColorRect.new(); r.mouse_filter = Control.MOUSE_FILTER_IGNORE; r.material = shader_mat("arc.gdshader"); r.material.set_shader_parameter("radius", 0.88)
		r.material.set_shader_parameter("colour", Vector3(0.55, 1.0, 0.60)); figure.add_child(r); rings.append(r)
	cone = ColorRect.new(); cone.mouse_filter = Control.MOUSE_FILTER_IGNORE; cone.material = shader_mat("cone.gdshader"); figure.add_child(cone)
	for j in range(3):
		var r2 = ColorRect.new(); r2.mouse_filter = Control.MOUSE_FILTER_IGNORE; r2.material = shader_mat("ring2.gdshader"); r2.material.set_shader_parameter("radius", 0.88)
		r2.material.set_shader_parameter("colour", Vector3(0.55, 1.0, 0.60)); figure.add_child(r2); rings2.append(r2)
	# the fire thrown off her blades (in the view's own space: it leaves her)
	for i in range(2):
		var key = "fireL" if i == 0 else "fireR"
		var foot = Vector2(L[key]["foot"][0], L[key]["foot"][1])
		for g in range(3):
			var s = Node2D.new(); s.visible = false; stage_f.add_child(s); sheds.append(s)
			var f = sprite(L[key]); f.position -= foot; s.add_child(f)
			var fg = sprite(L["glowL" if i == 0 else "glowR"]); fg.position -= foot; fg.material = addm; fg.modulate = Color(1, 1, 1, 0.6); s.add_child(fg)
	var hx = OFF.x + WHO.x + WHOX.x; var hy = OFF.y + WHO.y + WHOX.y
	who_glow = Sprite2D.new(); who_glow.texture = gt; who_glow.material = addm; who_glow.position = Vector2(hx, hy + 20); who_glow.scale = Vector2(7.0, 6.0); stage_f.add_child(who_glow)
	trail_front = Node2D.new(); stage_f.add_child(trail_front)
	fglow_f = Node2D.new(); stage_f.add_child(fglow_f)
	var wc = Curve.new(); wc.add_point(Vector2(0.0, 0.50)); wc.add_point(Vector2(1.0, 1.0))
	var tg = Gradient.new(); tg.offsets = PackedFloat32Array([0.0, 0.5, 1.0]); tg.colors = PackedColorArray([Color(0.25, 0.95, 0.35, 0.40), Color(0.35, 1.0, 0.40, 0.70), Color(0.80, 1.0, 0.65, 1.0)])
	for i in range(2):
