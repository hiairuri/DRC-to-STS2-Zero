func sm(a: float, b: float, x: float) -> float:
	return smoothstep(a, b, x)

func x_at(t: float) -> Dictionary:
	# Every number of her pose at time t.
	#   before 0: she waits.   0 .. T_BURST: the card is lit, she draws its light in and coils round it, slowly.
	#   T_BURST .. T_GO: the light is in her chest - held there, a flash.
	#   T_GO on: she bursts. She is big, and comes forward with her weight: quick off, long in arriving, and past
	#   where she holds, and back. Her blades come out of their handles as she comes; at the end of their swing
	#   part of their fire is thrown off. From then on it is her scream, held and shaking, her gauze drawn off her
	#   strip after strip, till nothing of her is left.
	var A = KEYS[0]; var B = KEYS[1]; var C = KEYS[2]
	var d := {}
	var coil = sm(0.0, 1.0, clamp(t / (T_BURST - 0.06), 0.0, 1.0))
	var s = t - T_GO                                                      # seconds of her scream
	var u = clamp(s / LUNGE, 0.0, 1.0)
	var out = 1.0 - pow(1.0 - pow(u, 1.35), 2.6)
	for key in A.keys():
		if key == "name": continue
		var coiled = lerp(float(A[key]), float(B[key]), 1.43 * coil)        # (the still of it is 70 % of the way in)
		d[key] = lerp(coiled, float(C[key]), out)
	if t > 0.25 and s <= 0.0:
		# (held in: she shakes with it)
		var trem = sm(0.25, 0.60, t)
		d["tilt"] += 0.5 * trem * sin(TAU * 13.0 * CL)
		d["sleeve"] += 0.7 * trem * sin(TAU * 13.0 * CL + 1.0)
	if s > 0.0:
		# past where she holds, and back, slowly; then she sinks back a little as she is drawn away
		var bump = sin(PI * clamp((s - 0.10) / 0.85, 0.0, 1.0))
		d["zoom"] += 0.045 * bump - 0.04 * sm(0.9, 2.6, s)
		d["sink"] += 10.0 * bump
		# her hair comes after her: thrown up later, then it rides her scream
		var late = sm(0.08, 0.66, s)
		d["fan"] = lerp(float(B["fan"]) * 1.43, float(C["fan"]) + 8.0 * exp(-s / 0.40), late)
		d["flare"] = lerp(float(B["flare"]) * 1.43, float(C["flare"]), late)
		var wob = sin(TAU * 6.7 * s) * sm(0.15, 0.50, s)
		d["tilt"] += 0.8 * wob
		d["breath"] += 0.08 * wob
		d["eye_rot"] += 3.0 * sin(TAU * 6.7 * s + 1.0) * sm(0.15, 0.50, s)
	# her knives: bare handles till she bursts; then the fire out of them as she comes forward - far; and when
	# part of it is thrown off, what is left is a blade that burns
	var bl = 0.0
	if s > 0.0:
		bl = 2.5 * (1.0 - pow(1.0 - clamp(s / 0.26, 0.0, 1.0), 2.0))
		bl = lerp(bl, 1.75, sm(0.0, 0.16, t - T_REL))
		bl *= 1.0 - sm(1.55, 2.35, s)
	d["blade_l"] = bl
	d["blade_w"] = lerp(1.5, 1.2, sm(0.0, 0.30, t - T_REL))
	d["amount"] = 2.0 if s > 0.0 else 1.0
	d["blast"] = (44.0 + 26.0 * exp(-s / 0.30)) * sm(0.0, 0.16, s) if s > 0.0 else 0.0
	var sb = t - T_BURST
	d["flashc"] = exp(-sb / 0.11) if sb > 0.0 else 0.0
	d["back"] = (0.25 + 0.45 * exp(-s / 0.40)) * sm(0.0, 0.12, s) * (1.0 - sm(1.9, 2.7, s)) if s > 0.0 else 0.0
	d["ringa"] = sm(0.0, 0.15, s) * (1.0 - sm(1.9, 2.6, s))
	d["ring"] = 1.0 if s > 0.0 else 0.0
	d["dark"] = lerp(float(A["dark"]), 0.70, coil) if s <= 0.0 else lerp(0.70, lerp(0.60, 0.50, sm(2.0, 2.8, s)), sm(0.0, 0.10, s))
	d["shade"] = 0.18 * coil * (1.0 - out)
	# the card and the light she draws out of it
	d["card"] = 1.0 if (t >= 0.0 and t < T_BURST + 0.03) else 0.0
	d["streak"] = clamp(t / T_BURST, 0.0, 1.0) if (t >= 0.0 and t < T_BURST) else -1.0
	# the fire thrown off her blades: on along the way their tips were going - up and back - and down again, into him
	var f = (t - T_REL) / FLY
	d["fly"] = f if (f >= 0.0 and f < 1.45) else -1.0
	d["who"] = sm(T_HIT - 0.02, T_HIT + 0.12, t) * (1.0 - sm(T_HIT + 0.70, T_HIT + 1.50, t))        # (it goes into him, and fades out of him)
	# her gauze drawn off her, and she with it; the fire of her eye the last of her
	d["pull"] = t - T_PULL
	d["strip"] = 0.0
	d["body"] = 1.0 - sm(1.00, 1.90, s)
	d["glow"] = float(d["glow"]) * (1.0 - sm(1.5, 2.3, s))
	d["eye_len"] = float(d["eye_len"]) * (1.0 - sm(2.45, 2.80, s))
	d["eyea"] = 1.0 - sm(2.55, 2.85, s)
	d["veil"] = float(d["dark"]) * (1.0 - sm(2.3, 3.0, s))        # (the field comes back as the last of her goes)
	return d

func fmap(f: float) -> float:
	# how far along its way the thrown fire is: thrown fast, slower and slower to the top of its way, where it
	# all but hangs; then it falls, faster and faster
	var a = APEX; var fa = 0.45
	if f <= 0.0: return 0.0
	if f >= 1.0: return 1.0
	if f < fa: return a * (1.0 - pow(1.0 - f / fa, 1.8))
	return a + (1.0 - a) * pow((f - fa) / (1.0 - fa), 1.9)
